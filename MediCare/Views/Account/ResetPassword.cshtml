@model MediCare.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Đặt lại mật khẩu";
}

<section class="login-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="auth-card">
                    <div class="auth-form">
                        <h2>Đặt lại mật khẩu</h2>
                        <p class="lead">Nhập mật khẩu mới cho tài khoản MediCare của bạn.</p>

                        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.Token)
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                            <div class="mb-3">
                                <label class="form-label" for="NewPassword">Mật khẩu mới</label>
                                <div style="position: relative;">
                                    <span style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--mc-gray);">
                                        <i class="fas fa-lock"></i>
                                    </span>
                                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", style = "padding-left: 2.75rem;", placeholder = "Nhập mật khẩu mới (tối thiểu 6 ký tự)", required = "required" })
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="ConfirmPassword">Xác nhận mật khẩu</label>
                                <div style="position: relative;">
                                    <span style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--mc-gray);">
                                        <i class="fas fa-lock"></i>
                                    </span>
                                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", style = "padding-left: 2.75rem;", placeholder = "Nhập lại mật khẩu mới", required = "required" })
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill mb-3">
                                <i class="fas fa-key me-2"></i>Đặt lại mật khẩu
                            </button>

                            <p class="text-center mb-0" style="color: var(--mc-gray);">
                                @Html.ActionLink("Quay lại đăng nhập", "Login", "Account", null, new { style = "font-weight: 600; color: var(--mc-primary);" })
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
