@model MediCare.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Quên mật khẩu";
}

<section class="login-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                @if (TempData["ForgotMessage"] != null)
                {
                    <div class="alert alert-success mb-4">
                        <i class="fas fa-circle-check me-2"></i>@TempData["ForgotMessage"]
                    </div>
                }
                @if (TempData["ForgotDevLink"] != null)
                {
                    <div class="alert alert-warning mb-4">
                        <i class="fas fa-triangle-exclamation me-2"></i>
                        <strong>Chế độ demo:</strong> SMTP chưa được cấu hình nên email không thực sự được gửi.
                        Bạn có thể dùng liên kết đặt lại mật khẩu sau:
                        <div class="mt-2 text-break">
                            <a href="@(TempData["ForgotDevLink"])">@TempData["ForgotDevLink"]</a>
                        </div>
                    </div>
                }
                <div class="auth-card">
                    <div class="auth-form">
                        <h2>Quên mật khẩu</h2>
                        <p class="lead">Nhập email hoặc số điện thoại đã đăng ký để nhận liên kết đặt lại mật khẩu.</p>

                        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                            <div class="mb-3">
                                <label class="form-label" for="Identity">Email / Số điện thoại</label>
                                <div style="position: relative;">
                                    <span style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--mc-gray);">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    @Html.TextBoxFor(m => m.Identity, new { @class = "form-control", style = "padding-left: 2.75rem;", placeholder = "Nhập email hoặc số điện thoại", required = "required" })
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill mb-3">
                                <i class="fas fa-paper-plane me-2"></i>Gửi yêu cầu
                            </button>

                            <p class="text-center mb-0" style="color: var(--mc-gray);">
                                @Html.ActionLink("Quay lại đăng nhập", "Login", "Account", null, new { style = "font-weight: 600; color: var(--mc-primary);" })
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
