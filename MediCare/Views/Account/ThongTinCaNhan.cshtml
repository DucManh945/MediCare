@model MediCare.Models.ProfileViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section SidebarNav {
    if (Model.IsDoctor)
    {
        @Html.Partial("~/Views/Shared/_DoctorSidebar.cshtml")
    }
    else if (User.IsInRole("Quản lý phòng khám") || User.IsInRole("Quản lý"))
    {
        @Html.Partial("~/Views/ClinicManager/_ClinicManagerSidebar.cshtml")
    }
    else
    {
        @Html.Partial("~/Views/Shared/_AdminSidebar.cshtml")
    }
}

@if (TempData["ProfileMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4"><i class="fas fa-circle-check me-2"></i>@TempData["ProfileMessage"]</div>
}

<div class="dash-card">
    <div class="dash-card-header">
        <h3 class="dash-card-title mb-0"><i class="fas fa-user-pen text-primary me-2"></i>Thông tin cá nhân</h3>
    </div>
    <div class="dash-card-body">
        @using (Html.BeginForm("ThongTinCaNhan", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.UserId)
            @Html.HiddenFor(m => m.Username)
            @Html.HiddenFor(m => m.AvatarUrl)

            if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null)
            {
                <div class="alert alert-danger">@Html.ValidationMessage("")</div>
            }

            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="text-center">
                        <label class="form-label fw-semibold d-block mb-3">Ảnh đại diện (hiển thị trang chủ)</label>
                        <div class="mb-3">
                            <img id="avatarPreview"
                                 src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? "" : Model.AvatarUrl)"
                                 alt="Ảnh đại diện"
                                 style="width:160px;height:160px;object-fit:cover;border-radius:50%;border:3px solid var(--mc-primary,#0ea5e9);@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? "display:none;" : "")" />
                            <div id="avatarPlaceholder" class="d-inline-flex align-items-center justify-content-center"
                                 style="width:160px;height:160px;border-radius:50%;border:3px dashed #cbd5e1;background:#f8fafc;color:#94a3b8;@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? "" : "display:none;")">
                                <i class="fas fa-user fa-3x"></i>
                            </div>
                        </div>
                        <input type="file" name="AvatarFile" id="AvatarFile" class="form-control" accept="image/png,image/jpeg,image/jpg,image/gif,image/webp" />
                        @Html.ValidationMessage("AvatarFile", new { @class = "text-danger small d-block mt-1" })
                        <div class="small text-muted mt-2">Chấp nhận JPG, PNG, GIF, WEBP. Tối đa 2MB.</div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tên đăng nhập</label>
                            <input type="text" class="form-control" value="@Model.Username" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại</label>
                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Giới tính</label>
                            <select name="Gender" class="form-select">
                                <option value="" @(string.IsNullOrWhiteSpace(Model.Gender) ? "selected" : "")>-- Chọn --</option>
                                <option value="Nam" @(Model.Gender == "Nam" ? "selected" : "")>Nam</option>
                                <option value="Nữ" @(Model.Gender == "Nữ" ? "selected" : "")>Nữ</option>
                                <option value="Khác" @(Model.Gender == "Khác" ? "selected" : "")>Khác</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Ngày sinh</label>
                            <input type="date" name="BirthDate" class="form-control" value="@(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("yyyy-MM-dd") : "")" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Địa chỉ</label>
                            @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    @if (Model.IsDoctor)
                    {
                        <hr class="my-4" />
                        <h6 class="fw-semibold mb-3"><i class="fas fa-user-doctor text-primary me-2"></i>Thông tin chuyên môn</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Chuyên khoa</label>
                                <input type="text" class="form-control" value="@(string.IsNullOrWhiteSpace(Model.KhoaName) ? "Chưa phân khoa" : Model.KhoaName)" disabled />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Số năm kinh nghiệm</label>
                                @Html.TextBoxFor(m => m.SoNamKinhNghiem, new { @class = "form-control", type = "number", min = "0", max = "80" })
                                @Html.ValidationMessageFor(m => m.SoNamKinhNghiem, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Giới thiệu ngắn</label>
                                @Html.TextAreaFor(m => m.GioiThieu, new { @class = "form-control", rows = 3, maxlength = 500 })
                                @Html.ValidationMessageFor(m => m.GioiThieu, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4 py-2"><i class="fas fa-floppy-disk me-1"></i>Lưu thay đổi</button>
                <a href="@Url.Action("TwoFactorSetup", "Account")" class="btn btn-outline-secondary px-4 py-2"><i class="fas fa-shield-halved me-1"></i>Bảo mật &amp; 2FA</a>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        // @@ts-nocheck
        $('#AvatarFile').on('change', function () {
            var file = this.files && this.files[0];
            if (!file) return;
            var reader = new FileReader();
            reader.onload = function (e) {
                $('#avatarPreview').attr('src', e.target.result).show();
                $('#avatarPlaceholder').hide();
            };
            reader.readAsDataURL(file);
        });
    </script>
}
