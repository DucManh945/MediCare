@model MediCare.Models.RegisterViewModel
@{
    ViewBag.Title = "Đăng ký tài khoản";
}

<section class="login-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-9">
                <div class="auth-card">
                    <div class="row g-0">
                        <div class="col-lg-5 d-none d-lg-block">
                            <div class="auth-side h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="logo-icon-lg">
                                        <i class="fas fa-user-plus"></i>
                                    </div>
                                    <h2 class="text-white mb-3">Tạo tài khoản<br />MediCare</h2>
                                    <p style="opacity: 0.9; margin-bottom: 2rem;">
                                        Trở thành thành viên MediCare để trải nghiệm dịch vụ chăm sóc sức khỏe toàn diện với ưu đãi đặc biệt.
                                    </p>
                                </div>
                                <div>
                                    <div class="mb-4">
                                        <div class="d-flex align-items-center gap-3 mb-3">
                                            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,0.2); display: inline-flex; align-items: center; justify-content: center;">
                                                <i class="fas fa-gift"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block">Ưu đãi 20% lần khám đầu</strong>
                                                <small style="opacity: 0.85;">Miễn phí thành viên</small>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-3 mb-3">
                                            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,0.2); display: inline-flex; align-items: center; justify-content: center;">
                                                <i class="fas fa-users"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block">Quản lý hồ sơ gia đình</strong>
                                                <small style="opacity: 0.85;">Hiển thị thành viên trong tài khoản</small>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-3">
                                            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,0.2); display: inline-flex; align-items: center; justify-content: center;">
                                                <i class="fas fa-bell"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block">Thông báo &amp; nhắc lịch</strong>
                                                <small style="opacity: 0.85;">Không bao giờ bỏ lỡ lịch hẹn</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="auth-form">
                                <h2>Đăng ký tài khoản</h2>
                                <p class="lead">Đăng ký miễn phí, nhanh chóng chỉ 2 phút</p>

                                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { autocomplete = "on" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.ValidationSummary(true, "Đăng ký không thành công.", new { @class = "alert alert-danger" })
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label" for="FullName">Họ và tên</label>
                                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Nhập họ và tên", required = "required", autocomplete = "name" })
                                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="Phone">Số điện thoại</label>
                                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "09xx xxx xxx", required = "required", autocomplete = "tel" })
                                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" for="Email">Email</label>
                                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "your@email.com", required = "required", autocomplete = "email" })
                                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label" for="Password">Mật khẩu</label>
                                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mật khẩu (8+ ký tự)", required = "required", autocomplete = "new-password" })
                                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="ConfirmPassword">Xác nhận mật khẩu</label>
                                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu", required = "required", autocomplete = "new-password" })
                                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                                        </div>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label" for="BirthDate">Ngày sinh</label>
                                        @Html.TextBoxFor(m => m.BirthDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="Gender">Giới tính</label>
                                            <select id="Gender" name="Gender" class="form-select">
                                                <option value="">-- Chọn --</option>
                                                <option value="Nam">Nam</option>
                                                <option value="Nữ">Nữ</option>
                                                <option value="Khác">Khác</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label" for="Address">Địa chỉ</label>
                                        @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "Nhập địa chỉ của bạn", autocomplete = "street-address" })
                                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                                    </div>

                                    <div class="form-check mb-4">
                                        @Html.CheckBoxFor(m => m.Agree, new { @class = "form-check-input", id = "agree", required = "required" })
                                        <label class="form-check-label" for="agree">
                                            Tôi đồng ý với <a href="#" style="color: var(--mc-primary);">Điều khoản dịch vụ</a> và <a href="#" style="color: var(--mc-primary);">Chính sách bảo mật</a> của MediCare
                                        </label>
                                        @Html.ValidationMessageFor(m => m.Agree, "", new { @class = "text-danger small d-block" })
                                    </div>

                                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill mb-3">
                                        <i class="fas fa-user-plus me-2"></i>Tạo tài khoản
                                    </button>

                                    <p class="text-center mb-0" style="color: var(--mc-gray);">
                                        Đã có tài khoản?
                                        @Html.ActionLink("Đăng nhập", "Login", "Account", null, new { style = "font-weight: 600; color: var(--mc-primary);" })
                                    </p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
