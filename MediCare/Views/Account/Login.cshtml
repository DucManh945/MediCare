@model MediCare.Models.LoginViewModel
@{
    ViewBag.Title = "Đăng nhập";
}

<section class="login-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8">
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-success mb-4">
                        <i class="fas fa-circle-check me-2"></i>@TempData["Message"]
                    </div>
                }
                <div class="auth-card">
                    <div class="row g-0">
                        <div class="col-lg-5 d-none d-lg-block">
                            <div class="auth-side h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="logo-icon-lg">
                                        <i class="fas fa-heartbeat"></i>
                                    </div>
                                    <h2 class="text-white mb-3">Chào mừng<br />trở lại!</h2>
                                    <p style="opacity: 0.9; margin-bottom: 2rem;">
                                        Đăng nhập tài khoản MediCare để đặt lịch khám, quản lý hồ sơ sức khỏe của bạn và gia đình.
                                    </p>
                                </div>
                                <div>
                                    <div class="mb-4">
                                        <div class="d-flex align-items-center gap-3 mb-3">
                                            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,0.2); display: inline-flex; align-items: center; justify-content: center;">
                                                <i class="fas fa-calendar-check"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block">Đặt lịch nhanh</strong>
                                                <small style="opacity: 0.85;">Chỉ 60 giây để đặt lịch</small>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-3 mb-3">
                                            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,0.2); display: inline-flex; align-items: center; justify-content: center;">
                                                <i class="fas fa-file-medical"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block">Hồ sơ điện tử</strong>
                                                <small style="opacity: 0.85;">Lưu trữ toàn bộ lịch sử bệnh án</small>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-3">
                                            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,0.2); display: inline-flex; align-items: center; justify-content: center;">
                                                <i class="fas fa-flask-vial"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block">Kết quả xét nghiệm</strong>
                                                <small style="opacity: 0.85;">Nhận kết quả nhanh chóng online</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="auth-form">
                                <h2>Đăng nhập</h2>
                                <p class="lead">Truy cập tài khoản MediCare của bạn</p>

                                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { autocomplete = "on" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.ValidationSummary(true, "Đăng nhập không thành công.", new { @class = "alert alert-danger" })
                                    <input type="hidden" name="returnUrl" value="@Request.QueryString["ReturnUrl"]" />
                                    <div class="mb-3">
                                        <label class="form-label" for="UserName">Email / Số điện thoại</label>
                                        <div style="position: relative;">
                                            <span style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--mc-gray);">
                                                <i class="fas fa-user"></i>
                                            </span>
                                            @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", style = "padding-left: 2.75rem;", placeholder = "Nhập email hoặc số điện thoại", required = "required", autocomplete = "username" })
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="Password">Mật khẩu</label>
                                        <div style="position: relative;">
                                            <span style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--mc-gray);">
                                                <i class="fas fa-lock"></i>
                                            </span>
                                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", style = "padding-left: 2.75rem;", placeholder = "Nhập mật khẩu", required = "required", autocomplete = "current-password" })
                                            <span id="togglePw" style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); color: var(--mc-gray); cursor: pointer;">
                                                <i class="fas fa-eye"></i>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <div class="form-check mb-0">
                                            @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input", id = "remember" })
                                            <label class="form-check-label" for="remember">Ghi nhớ đăng nhập</label>
                                        </div>
                                        @Html.ActionLink("Quên mật khẩu?", "ForgotPassword", "Account", null, new { style = "color: var(--mc-primary); font-weight: 600;" })
                                    </div>

                                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill mb-3">
                                        <i class="fas fa-right-to-bracket me-2"></i>Đăng nhập
                                    </button>

                                    <p class="text-center mb-0" style="color: var(--mc-gray);">
                                        Chưa có tài khoản?
                                        @Html.ActionLink("Đăng ký ngay", "Register", "Account", null, new { style = "font-weight: 600; color: var(--mc-primary);" })
                                    </p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
