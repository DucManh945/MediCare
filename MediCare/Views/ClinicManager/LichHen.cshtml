@model MediCare.Models.AppointmentListViewModel
@{
    ViewBag.Title = "Lịch hẹn";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var error = ViewBag.AppointmentError as string;
    ViewBag.ActiveManagerMenu = "appointments";
}
@section SidebarNav {
    @Html.Partial("_ClinicManagerSidebar")
}
<div class="appointment-page">
    <div class="page-heading d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="mb-1">Lịch hẹn & Điều phối bệnh nhân</h2><p class="text-muted mb-0">Dữ liệu lịch hẹn trực tiếp từ hệ thống</p></div>
        <a class="btn btn-outline-secondary" href="@Url.Action("LichHen")"><i class="fas fa-rotate-right me-1"></i>Làm mới</a>
    </div>
    @if (!String.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger">@error</div> }
    @if (TempData["AppointmentError"] != null) { <div class="alert alert-danger">@TempData["AppointmentError"]</div> }
    @if (TempData["AppointmentMessage"] != null) { <div class="alert alert-success">@TempData["AppointmentMessage"]</div> }
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3"><div class="card dashboard-stat-card h-100 p-3"><small class="text-muted">Tổng lịch</small><strong class="fs-3">@Model.TotalAppointments</strong></div></div>
        <div class="col-12 col-sm-6 col-xl-3"><div class="card dashboard-stat-card h-100 p-3"><small class="text-muted">Đã đặt</small><strong class="fs-3 text-primary">@Model.BookedAppointments</strong></div></div>
        <div class="col-12 col-sm-6 col-xl-3"><div class="card dashboard-stat-card h-100 p-3"><small class="text-muted">Đã khám</small><strong class="fs-3 text-success">@Model.CompletedAppointments</strong></div></div>
        <div class="col-12 col-sm-6 col-xl-3"><div class="card dashboard-stat-card h-100 p-3"><small class="text-muted">Đã hủy</small><strong class="fs-3 text-danger">@Model.CancelledAppointments</strong></div></div>
    </div>
    <div class="appointment-tabs mb-3">
        <a class="btn @(Model.Preset == "today" ? "btn-primary" : "btn-outline-primary")" href="@Url.Action("LichHen", new { preset = "today" })"><i class="fas fa-calendar-day me-1"></i>Hôm nay</a>
        <a class="btn @(Model.Preset == "tomorrow" ? "btn-primary" : "btn-outline-primary")" href="@Url.Action("LichHen", new { preset = "tomorrow" })"><i class="fas fa-calendar-plus me-1"></i>Ngày mai</a>
        <a class="btn @(Model.Preset == "week" ? "btn-primary" : "btn-outline-primary")" href="@Url.Action("LichHen", new { preset = "week" })"><i class="fas fa-calendar-week me-1"></i>Tuần này</a>
        <a class="btn @(String.IsNullOrEmpty(Model.Preset) && !Model.FromDate.HasValue && !Model.ToDate.HasValue ? "btn-primary" : "btn-outline-secondary")" href="@Url.Action("LichHen")">Tất cả</a>
    </div>
    @using (Html.BeginForm("LichHen", "ClinicManager", FormMethod.Get, new { @class = "card filter-card mb-4" }))
    {
        <div class="card-body"><div class="row g-3 align-items-end">
            <div class="col-md-3"><label>Từ khóa</label><input name="search" value="@Model.Search" class="form-control" placeholder="Mã lịch, mã BN, tên, điện thoại" /></div>
            <div class="col-md-2"><label>Bác sĩ</label><select name="doctorId" class="form-control"><option value="">Tất cả</option>@foreach (var d in Model.Doctors) { <option value="@d.UserId" @(Model.DoctorId == d.UserId ? "selected" : "")>@d.FullName</option> }</select></div>
            <div class="col-md-2"><label>Trạng thái</label><select name="status" class="form-control"><option value="">Tất cả</option><option value="Đã đặt" @(Model.Status == "Đã đặt" ? "selected" : "")>Đã đặt</option><option value="Đã khám" @(Model.Status == "Đã khám" ? "selected" : "")>Đã khám</option><option value="Hủy" @(Model.Status == "Hủy" ? "selected" : "")>Hủy</option></select></div>
            <div class="col-md-2"><label>Từ ngày</label><input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
            <div class="col-md-2"><label>Đến ngày</label><input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
            <div class="col-md-1"><button class="btn btn-primary w-100" type="submit"><i class="fas fa-filter me-1"></i>Lọc</button></div>
        </div></div>
    }
    @if (Model.Items.Count == 0) { <div class="alert alert-info">Không tìm thấy lịch hẹn phù hợp.</div> }
    else {
        <div class="card table-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Mã</th>
                                <th>Ngày giờ</th>
                                <th>STT</th>
                                <th>Bệnh nhân</th>
                                <th>Điện thoại</th>
                                <th>Bác sĩ phụ trách</th>
                                <th>Lý do</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items) {
                                <tr>
                                    <td><strong>#@item.MaLichHen</strong></td>
                                    <td>@item.NgayKham.ToString("dd/MM/yyyy")<br /><small class="text-muted">@item.GioKham</small></td>
                                    <td><span class="badge bg-secondary">@(item.SoThuTu.HasValue ? item.SoThuTu.Value.ToString() : "—")</span></td>
                                    <td>@item.BenhNhanName <small class="text-muted">(#@item.BenhNhanId)</small></td>
                                    <td>@(item.BenhNhanPhone ?? "-")</td>
                                    <td>
                                        @if (item.BacSiId.HasValue) {
                                            <span class="text-primary font-weight-bold"><i class="fas fa-user-md me-1"></i>@item.BacSiName</span>
                                        } else if (item.TrangThai == "Đã đặt") {
                                            using (Html.BeginForm("PhanCongBacSi", "ClinicManager", FormMethod.Post, new { @class = "d-flex gap-1" })) {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.MaLichHen" />
                                                <select name="doctorId" class="form-select form-select-sm" required style="max-width: 150px;">
                                                    <option value="">-- Gán BS --</option>
                                                    @foreach (var doc in Model.Doctors) {
                                                        <option value="@doc.UserId">@doc.FullName</option>
                                                    }
                                                </select>
                                                <button class="btn btn-sm btn-primary" type="submit">Gán</button>
                                            }
                                        } else {
                                            <span class="text-muted">Chưa gán</span>
                                        }
                                    </td>
                                    <td>@(item.LyDoKham ?? "-")</td>
                                    <td>
                                        <span class="badge @(item.TrangThai == "Đã khám" ? "bg-success" : (item.TrangThai == "Hủy" ? "bg-danger" : "bg-warning text-dark"))">
                                            @item.TrangThai
                                        </span>
                                    </td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-info me-1" href="@Url.Action("ChiTietLichHen", new { id = item.MaLichHen })">Xem</a>
                                        @if (item.TrangThai == "Đã đặt") {
                                            using (Html.BeginForm("CapNhatTrangThaiLichHen", "ClinicManager", FormMethod.Post, new { style = "display:inline" })) {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.MaLichHen" />
                                                <input type="hidden" name="status" value="Hủy" />
                                                <button class="btn btn-sm btn-outline-danger" type="submit">Hủy</button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        if (Model.TotalPages > 1) { <nav class="mt-3"><ul class="pagination">@for (var p = 1; p <= Model.TotalPages; p++) { <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Url.Action("LichHen", new { search = Model.Search, doctorId = Model.DoctorId, status = Model.Status, fromDate = Model.FromDate, toDate = Model.ToDate, preset = Model.Preset, page = p })">@p</a></li> }</ul></nav> }
    }
</div>
<style>
    .appointment-page .dashboard-stat-card { border: 0; border-left: 4px solid #2563eb; box-shadow: 0 4px 14px rgba(15, 23, 42, .06); }
    .appointment-page .filter-card, .appointment-page .table-card { border: 0; box-shadow: 0 4px 14px rgba(15, 23, 42, .06); }
    .appointment-tabs { display: flex; flex-wrap: wrap; gap: .5rem; }
    .appointment-page th { white-space: nowrap; font-size: .82rem; color: #64748b; }
    .appointment-page td { white-space: nowrap; }
    @@media (max-width: 767.98px) { .appointment-page .page-heading { align-items: flex-start !important; gap: 1rem; flex-direction: column; } }
</style>
