@model MediCare.Models.UserEditViewModel
<div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-lg-5">
        @using (Html.BeginForm(Model.UserId == 0 ? "ThemTaiKhoan" : "SuaTaiKhoan", "ClinicManager", FormMethod.Post, new { @class = "row g-3 needs-validation", id = "accountForm", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.UserId)

            <div class="col-md-6">
                @Html.LabelFor(m => m.Username, "Tên đăng nhập", new { @class = "form-label" })
                @if (Model.UserId == 0) { @Html.TextBoxFor(m => m.Username, new { @class = "form-control" }) } else { @Html.TextBoxFor(m => m.Username, new { @class = "form-control", @readonly = "readonly" }) }
                @Html.ValidationMessageFor(m => m.Username, null, new { @class = "text-danger small d-block mt-1" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(m => m.FullName, "Họ và tên", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.FullName, null, new { @class = "text-danger small d-block mt-1" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(m => m.Email, "Email", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                @Html.ValidationMessageFor(m => m.Email, null, new { @class = "text-danger small d-block mt-1" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(m => m.Phone, "Số điện thoại", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(m => m.Password, Model.UserId == 0 ? "Mật khẩu khởi tạo" : "Mật khẩu mới (bỏ trống nếu không đổi)", new { @class = "form-label" })
                @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Password, null, new { @class = "text-danger small d-block mt-1" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(m => m.RoleId, "Vai trò", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.RoleId, new SelectList(Model.Roles, "RoleId", "RoleName", Model.RoleId), "-- Chọn vai trò --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.RoleId, null, new { @class = "text-danger small d-block mt-1" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(m => m.MaKhoa, "Khoa", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.MaKhoa, new SelectList(Model.Departments, "MaKhoa", "TenKhoa", Model.MaKhoa), "-- Không chọn --", new { @class = "form-select" })
            </div>
            <div class="col-md-3">
                @Html.LabelFor(m => m.Gender, "Giới tính", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Gender, new { @class = "form-control" })
            </div>
            <div class="col-md-3">
                @Html.LabelFor(m => m.BirthDate, "Ngày sinh", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.BirthDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(m => m.Address, "Địa chỉ", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
            </div>
            <div class="col-12">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                    @Html.LabelFor(m => m.IsActive, "Đang hoạt động", new { @class = "form-check-label" })
                </div>
            </div>

            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger col-12 mb-0" })

            <div class="col-12 d-flex justify-content-end gap-2 mt-3">
                @if (Request.IsAjaxRequest())
                {
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                }
                else
                {
                    <a href="@Url.Action("QuanLyTaiKhoan", "ClinicManager")" class="btn btn-outline-secondary">Hủy</a>
                }
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Lưu</button>
            </div>
        }
    </div>
</div>
