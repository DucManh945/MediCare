@model MediCare.Models.MedicalRecordSearchViewModel
@using System.Linq
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var currentTab = Model.Tab ?? "all";
}
@section SidebarNav {
    @Html.Partial("_ClinicManagerSidebar")
}

@if (ViewBag.DatabaseError != null) { <div class="alert alert-warning">@ViewBag.DatabaseError</div> }
@if (TempData["MedicalRecordMessage"] != null) { <div class="alert alert-success">@TempData["MedicalRecordMessage"]</div> }
@if (!string.IsNullOrWhiteSpace(Model.ValidationMessage)) { <div class="alert alert-danger"><i class="fas fa-triangle-exclamation me-2"></i>@Model.ValidationMessage</div> }

<div class="row g-4 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="stat-box">
            <div class="stat-box-icon blue"><i class="fas fa-folder-open"></i></div>
            <div>
                <span class="stat-box-number">@Model.TotalRecords</span>
                <span class="stat-box-label">Tổng số hồ sơ</span>
                <span class="stat-box-change up">Dữ liệu thực tế</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-box">
            <div class="stat-box-icon green"><i class="fas fa-user-doctor"></i></div>
            <div>
                <span class="stat-box-number">@Model.ResponsibleDoctorCount</span>
                <span class="stat-box-label">Bác sĩ phụ trách</span>
                <span class="stat-box-change up">Đã có hồ sơ khám</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-box">
            <div class="stat-box-icon orange"><i class="fas fa-people-group"></i></div>
            <div>
                <span class="stat-box-number">@Model.ActiveRecordCount</span>
                <span class="stat-box-label">Hồ sơ còn hoạt động</span>
                <span class="stat-box-change up">Theo trạng thái khám</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-box">
            <div class="stat-box-icon purple"><i class="fas fa-magnifying-glass"></i></div>
            <div>
                <span class="stat-box-number">@(Model.HasLookupLog ? Model.LookupCountDisplay : "—")</span>
                <span class="stat-box-label">Lượt tra cứu tháng</span>
                <span class="stat-box-change @(Model.HasLookupLogTable ? "up" : "down")">@(Model.HasLookupLogTable ? "Dữ liệu log" : "Chưa có dữ liệu thống kê")</span>
            </div>
        </div>
    </div>
</div>

<div class="dash-card">
    <div class="dash-card-header">
        <h3 class="dash-card-title"><i class="fas fa-magnifying-glass"></i> Tra cứu hồ sơ bệnh án</h3>
        <div class="d-flex gap-2">
            <a class="btn-dash btn-dash-outline" href="@Url.Action("XuatBaoCaoHoSoBenhAn", "ClinicManager", new { search=Model.Search, doctorId=Model.DoctorId, departmentId=Model.DepartmentId, fromDate=Model.FromDate, toDate=Model.ToDate, tab=currentTab })"><i class="fas fa-file-export"></i> Xuất báo cáo</a>
            <a class="btn-dash btn-dash-primary" href="@Url.Action("TaoHoSoBenhAn", "ClinicManager")"><i class="fas fa-plus"></i> Tạo hồ sơ mới</a>
        </div>
    </div>
    <div class="dash-card-body">
        @using (Html.BeginForm("HoSoBenhAn", "ClinicManager", FormMethod.Get, new { @class = "row g-3 mb-4" })) {
        <div class="col-lg-3"><input name="search" value="@Model.Search" class="form-control" placeholder="Mã BN, họ tên, SĐT" /></div>
        <div class="col-lg-2">
            <select name="departmentId" class="form-select">
                <option value="">-- Toàn phòng khám --</option>
                @foreach (var d in Model.Departments) {
                <option value="@d.MaKhoa" @(Model.DepartmentId == d.MaKhoa ? "selected" : "")>@d.TenKhoa</option>
                }
            </select>
        </div>
        <div class="col-lg-2">
            <select name="doctorId" class="form-select">
                <option value="">-- Tất cả bác sĩ --</option>
                @foreach (var d in Model.Doctors) {
                <option value="@d.UserId" @(Model.DoctorId == d.UserId ? "selected" : "")>@d.FullName</option>
                }
            </select>
        </div>
        <div class="col-lg-2">
            <input type="date" name="fromDate" value="@(Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")" class="form-control" />
        </div>
        <div class="col-lg-2">
            <input type="date" name="toDate" value="@(Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : "")" class="form-control" />
        </div>
        <div class="col-lg-1">
            <input type="hidden" name="tab" value="@currentTab" />
            <button class="btn-dash btn-dash-secondary w-100" title="Lọc"><i class="fas fa-filter"></i></button>
        </div>
        <div class="col-lg-1"><a class="btn-dash btn-dash-outline w-100" href="@Url.Action("HoSoBenhAn", "ClinicManager")" title="Đặt lại bộ lọc"><i class="fas fa-rotate-left"></i></a></div>
        }
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link @(currentTab == "all" ? "active" : "")" href="@Url.Action("HoSoBenhAn", new { search=Model.Search, doctorId=Model.DoctorId, departmentId=Model.DepartmentId, fromDate=Model.FromDate, toDate=Model.ToDate, tab="all" })">Tất cả</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentTab == "new" ? "active" : "")" href="@Url.Action("HoSoBenhAn", new { search=Model.Search, doctorId=Model.DoctorId, departmentId=Model.DepartmentId, fromDate=Model.FromDate, toDate=Model.ToDate, tab="new" })">Hồ sơ mới</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentTab == "followup" ? "active" : "")" href="@Url.Action("HoSoBenhAn", new { search=Model.Search, doctorId=Model.DoctorId, departmentId=Model.DepartmentId, fromDate=Model.FromDate, toDate=Model.ToDate, tab="followup" })">Tái khám</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentTab == "recovered" ? "active" : "")" href="@Url.Action("HoSoBenhAn", new { search=Model.Search, doctorId=Model.DoctorId, departmentId=Model.DepartmentId, fromDate=Model.FromDate, toDate=Model.ToDate, tab="recovered" })">Khỏi bệnh</a>
            </li>
        </ul>
        <div class="table-responsive mt-3">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Mã BN</th>
                        <th>Họ tên</th>
                        <th>Tuổi/Giới tính</th>
                        <th>Bác sĩ</th>
                        <th>Chuyên khoa</th>
                        <th>Ngày lập</th>
                        <th>Lần khám cuối</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any()) {
                    foreach (var item in Model.Items) {
                    <tr>
                        <td><strong style="color:var(--mc-primary);">@item.PatientCode</strong></td>
                        <td>@item.PatientName</td>
                        <td>@(item.Age.HasValue ? item.Age.Value + "t" : "—") / @(item.Gender ?? "—")</td>
                        <td>@item.DoctorName</td>
                        <td>@(item.DepartmentName ?? "—")</td>
                        <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.LastVisitDate.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge-pill badge-primary">@item.Status</span></td>
                        <td>
                            <a class="btn-dash btn-dash-secondary" href="@Url.Action("ChiTietHoSoBenhAn", new { id=item.PatientId })" title="Xem hồ sơ"><i class="fas fa-eye"></i></a>
                            <a class="btn-dash btn-dash-primary" href="@Url.Action("LichSuKhamBenhNhan", new { id=item.PatientId })" title="Xem lịch sử"><i class="fas fa-history"></i></a>
                        </td>
                    </tr>
                    }
                    } else {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">Không tìm thấy hồ sơ phù hợp.</td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1) {
        <nav class="mt-3">
            <ul class="pagination justify-content-end">
                @for (var p = 1; p <= Model.TotalPages; p++) {
                <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Url.Action("HoSoBenhAn", new { search=Model.Search, doctorId=Model.DoctorId, departmentId=Model.DepartmentId, fromDate=Model.FromDate, toDate=Model.ToDate, tab=currentTab, page=p })">@p</a></li>
                }
            </ul>
        </nav>
        }
    </div>
</div>
