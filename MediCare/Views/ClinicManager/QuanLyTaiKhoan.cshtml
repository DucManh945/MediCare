@model MediCare.Models.UserManagementListViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var activeTab = Model.Tab ?? "doctor";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h2 class="mb-1">Quản lý tài khoản & Nhân sự</h2><p class="text-muted mb-0">Dữ liệu tài khoản được lấy trực tiếp từ hệ thống.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-success" href="@Url.Action("XuatTaiKhoanCsv", new { tab = Model.Tab, search = Model.Search, role = Model.Role, khoa = Model.Khoa, status = Model.Status })"><i class="fas fa-file-csv me-1"></i>Xuất danh sách</a><button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#userModal" data-url="@Url.Action("ThemTaiKhoan")"><i class="fas fa-user-plus me-1"></i>Thêm tài khoản</button></div></div>
@if (ViewBag.DatabaseError != null) { <div class="alert alert-danger">@ViewBag.DatabaseError</div> }
@if (TempData["UserMessage"] != null) { <div class="alert alert-success">@TempData["UserMessage"]</div> }
@if (TempData["UserError"] != null) { <div class="alert alert-danger">@TempData["UserError"]</div> }
<div class="row g-3 mb-4"><div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Tổng tài khoản</small><h3 class="mb-0 mt-2">@Model.TotalUsers</h3></div></div></div><div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Bác sĩ</small><h3 class="mb-0 mt-2">@Model.TotalDoctors</h3></div></div></div><div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Bệnh nhân</small><h3 class="mb-0 mt-2">@Model.TotalPatients</h3></div></div></div><div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Hoạt động / Bị khóa</small><h3 class="mb-0 mt-2">@Model.ActiveUsers <small class="text-danger">/ @Model.LockedUsers</small></h3></div></div></div></div>
<ul class="nav nav-tabs mb-3"><li class="nav-item"><a class="nav-link @(activeTab == "doctor" ? "active" : "")" href="@Url.Action("QuanLyTaiKhoan", new { tab = "doctor", search = Model.Search, status = Model.Status })">Bác sĩ</a></li><li class="nav-item"><a class="nav-link @(activeTab == "patient" ? "active" : "")" href="@Url.Action("QuanLyTaiKhoan", new { tab = "patient", search = Model.Search, status = Model.Status })">Bệnh nhân</a></li><li class="nav-item"><a class="nav-link @(activeTab == "staff" ? "active" : "")" href="@Url.Action("QuanLyTaiKhoan", new { tab = "staff", search = Model.Search, status = Model.Status })">Nhân viên / Quản lý</a></li></ul>
<div class="card border-0 shadow-sm mb-4"><div class="card-body">@using (Html.BeginForm("QuanLyTaiKhoan", "ClinicManager", FormMethod.Get, new { @class = "row g-2 align-items-end" })) { <input type="hidden" name="tab" value="@Model.Tab" /><div class="col-lg-4"><label class="form-label">Tìm kiếm</label><input class="form-control" name="search" value="@Model.Search" placeholder="Mã, họ tên, username, email, điện thoại" /></div><div class="col-lg-3"><label class="form-label">Vai trò</label><select class="form-select" name="role"><option value="">Tất cả vai trò</option>@foreach (var item in Model.Roles) { <option value="@item.RoleName" @(Model.Role == item.RoleName ? "selected" : "")>@item.RoleName</option> }</select></div><div class="col-lg-2"><label class="form-label">Khoa</label><select class="form-select" name="khoa"><option value="">Tất cả khoa</option>@foreach (var item in Model.Departments) { <option value="@item.TenKhoa" @(Model.Khoa == item.TenKhoa ? "selected" : "")>@item.TenKhoa</option> }</select></div><div class="col-lg-2"><label class="form-label">Trạng thái</label><select class="form-select" name="status"><option value="">Tất cả</option><option value="active" @(Model.Status == "active" ? "selected" : "")>Hoạt động</option><option value="locked" @(Model.Status == "locked" ? "selected" : "")>Bị khóa</option></select></div><div class="col-lg-1 d-flex gap-1"><button class="btn btn-primary" type="submit"><i class="fas fa-search"></i></button><a class="btn btn-outline-secondary" href="@Url.Action("QuanLyTaiKhoan", new { tab = Model.Tab })"><i class="fas fa-rotate-left"></i></a></div> }</div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Mã</th><th>Họ tên</th><th>Tài khoản</th><th>Liên hệ</th><th>Vai trò</th><th>Khoa</th><th>Trạng thái</th><th></th></tr></thead><tbody>@if (Model.Items.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-5">Không tìm thấy tài khoản phù hợp.</td></tr> } else { foreach (var item in Model.Items) { <tr><td>#@item.UserId</td><td><strong>@item.FullName</strong></td><td>@item.Username</td><td>@(item.Email ?? "-")<br /><small>@(item.Phone ?? "-")</small></td><td>@item.RoleName</td><td>@(item.KhoaName ?? "-")</td><td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Hoạt động" : "Đã khóa")</span></td><td class="text-nowrap"><button class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#userModal" data-url="@Url.Action("ChiTietTaiKhoan", new { id = item.UserId })"><i class="fas fa-eye"></i></button> <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#userModal" data-url="@Url.Action("SuaTaiKhoan", new { id = item.UserId })"><i class="fas fa-pen"></i></button> @using (Html.BeginForm("ToggleTaiKhoan", "ClinicManager", new { id = item.UserId }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Xác nhận thay đổi trạng thái tài khoản?');" })) { @Html.AntiForgeryToken() <button class="btn btn-sm btn-outline-warning" type="submit"><i class="fas @(item.IsActive ? "fa-lock" : "fa-lock-open")"></i></button> } @using (Html.BeginForm("XoaTaiKhoan", "ClinicManager", new { id = item.UserId }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Chỉ tài khoản không có dữ liệu nghiệp vụ mới được xóa. Tiếp tục?');" })) { @Html.AntiForgeryToken() <button class="btn btn-sm btn-outline-danger" type="submit"><i class="fas fa-trash"></i></button> }</td></tr> } }</tbody></table></div>@if (Model.TotalPages > 1) { <div class="card-footer bg-white d-flex justify-content-between"><small>@Model.TotalItems tài khoản</small><nav><ul class="pagination mb-0">@for (var p = 1; p <= Model.TotalPages; p++) { <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Url.Action("QuanLyTaiKhoan", new { tab = Model.Tab, search = Model.Search, role = Model.Role, khoa = Model.Khoa, status = Model.Status, page = p })">@p</a></li> }</ul></nav></div> }</div>
<div class="modal fade" id="userModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Tài khoản</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="userModalBody"></div></div></div></div>
@section SidebarNav {
    @Html.Partial("_ClinicManagerSidebar")
}
@section scripts { <script>(function(){var m=document.getElementById('userModal');if(!m)return;m.addEventListener('show.bs.modal',function(e){var b=e.relatedTarget,body=document.getElementById('userModalBody');body.innerHTML='<div class="text-center py-4"><span class="spinner-border"></span></div>';fetch(b.getAttribute('data-url'),{headers:{'X-Requested-With':'XMLHttpRequest'}}).then(function(r){if(!r.ok)throw new Error('Không tải được dữ liệu tài khoản.');return r.text();}).then(function(t){body.innerHTML=t;}).catch(function(e){body.innerHTML='<div class="alert alert-danger">'+e.message+'</div>';});});})();</script> }
