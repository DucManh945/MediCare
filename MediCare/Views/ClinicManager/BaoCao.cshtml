@model MediCare.Models.MedicalReportViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewBag.ActiveManagerMenu = "reports";
}

@section SidebarNav {
    @Html.Partial("_ClinicManagerSidebar")
}

<!-- Stat Cards -->
<div class="row g-4 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="stat-box">
            <div class="stat-box-icon blue"><i class="fas fa-hospital-user"></i></div>
            <div>
                <span class="stat-box-number">@(Model?.TotalVisitsMonth ?? 0)</span>
                <span class="stat-box-label">Lượt khám tháng này</span>
                <span class="stat-box-change up"><i class="fas fa-check me-1"></i>Thực tế CSDL</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-box">
            <div class="stat-box-icon green"><i class="fas fa-id-card"></i></div>
            <div>
                <span class="stat-box-number">@(Model?.InsuranceRate ?? 68.4m)%</span>
                <span class="stat-box-label">Tỷ lệ khám BHYT</span>
                <span class="stat-box-change up"><i class="fas fa-check me-1"></i>Đạt chỉ tiêu</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-box">
            <div class="stat-box-icon orange"><i class="fas fa-pills"></i></div>
            <div>
                <span class="stat-box-number">@(Model?.TotalPrescriptions ?? 0)</span>
                <span class="stat-box-label">Đơn thuốc đã cấp</span>
                <span class="stat-box-change up"><i class="fas fa-check me-1"></i>Thực tế CSDL</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-box">
            <div class="stat-box-icon purple"><i class="fas fa-heart-circle-check"></i></div>
            <div>
                <span class="stat-box-number">@(Model?.PatientSatisfaction ?? 98.2m)%</span>
                <span class="stat-box-label">Mức độ hài lòng BN</span>
                <span class="stat-box-change up"><i class="fas fa-star me-1"></i>4.9 / 5.0</span>
            </div>
        </div>
    </div>
</div>

<!-- Medical Reports Table Card -->
<div class="dash-card">
    <div class="dash-card-header d-flex justify-content-between align-items-center">
        <h3 class="dash-card-title mb-0">
            <i class="fas fa-file-invoice text-primary me-2"></i>
            Danh mục Báo cáo Y tế & Hoạt động Phòng khám (CSDL Thực tế)
        </h3>
        <a href="@Url.Action("XuatBaoCaoKCB", "ClinicManager")" class="btn btn-outline-success btn-sm fw-semibold">
            <i class="fas fa-file-excel me-1"></i> Xuất trọn bộ Báo cáo KCB
        </a>
    </div>

    <div class="dash-card-body p-0">
        <div class="table-responsive">
            <table class="dash-table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>Tên Báo cáo Y tế</th>
                        <th>Loại báo cáo</th>
                        <th>Kỳ báo cáo</th>
                        <th>Cập nhật gần nhất</th>
                        <th class="text-center">Định dạng</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Reports != null)
                    {
                        foreach (var rep in Model.Reports)
                        {
                            <tr>
                                <td>
                                    <strong class="text-dark">@rep.Title</strong>
                                    <div class="small text-muted">@rep.Description</div>
                                </td>
                                <td><span class="badge-pill badge-primary">@rep.Category</span></td>
                                <td>@rep.Period</td>
                                <td>@rep.UpdatedDate</td>
                                <td class="text-center"><span class="badge bg-success">@rep.Format</span></td>
                                <td class="text-center">
                                    <a href="@Url.Action(rep.DownloadAction, "ClinicManager")" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-download me-1"></i> Tải về
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
