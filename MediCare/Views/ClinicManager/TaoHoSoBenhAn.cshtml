@model MediCare.Models.MedicalRecordCreateViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
@section SidebarNav {
    @Html.Partial("_ClinicManagerSidebar")
}
<div class="dash-card"><div class="dash-card-header"><h3 class="dash-card-title"><i class="fas fa-file-circle-plus"></i> Tạo hồ sơ bệnh án</h3><a href="@Url.Action("HoSoBenhAn")" class="btn-dash btn-dash-outline">Quay lại</a></div><div class="dash-card-body">
@using (Html.BeginForm("TaoHoSoBenhAn", "ClinicManager", FormMethod.Post)) {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "Vui lòng kiểm tra dữ liệu:", new { @class = "alert alert-danger" })
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Bệnh nhân</label><select name="PatientId" class="form-select" required><option value="">-- Chọn bệnh nhân --</option>@foreach (var p in Model.Patients) { <option value="@p.UserId" @(Model.PatientId == p.UserId ? "selected" : "")>@p.FullName @(string.IsNullOrWhiteSpace(p.Phone) ? "" : "- " + p.Phone)</option> }</select></div>
        <div class="col-md-6"><label class="form-label">Bác sĩ</label><select name="DoctorId" class="form-select" required><option value="">-- Chọn bác sĩ --</option>@foreach (var d in Model.Doctors) { <option value="@d.UserId" @(Model.DoctorId == d.UserId ? "selected" : "")>@d.FullName</option> }</select></div>
        <div class="col-md-4"><label class="form-label">Mã lịch hẹn (không bắt buộc)</label><input name="AppointmentId" value="@Model.AppointmentId" type="number" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Ngày khám</label><input name="ExaminationDate" value="@Model.ExaminationDate.ToString("yyyy-MM-ddTHH:mm")" type="datetime-local" class="form-control" required /></div>
        <div class="col-md-4"><label class="form-label">Trạng thái</label><select name="Status" class="form-select"><option value="Đang khám">Đang khám</option><option value="Hoàn thành">Hoàn thành</option><option value="Hủy">Hủy</option></select></div>
        <div class="col-md-4"><label class="form-label">Huyết áp</label><input name="BloodPressure" value="@Model.BloodPressure" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Mạch</label><input name="Pulse" value="@Model.Pulse" type="number" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Nhiệt độ</label><input name="Temperature" value="@Model.Temperature" type="number" step="0.1" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Cân nặng</label><input name="Weight" value="@Model.Weight" type="number" step="0.1" class="form-control" /></div>
        <div class="col-md-8"><label class="form-label">Triệu chứng</label><textarea name="Symptoms" class="form-control" rows="2">@Model.Symptoms</textarea></div>
        <div class="col-md-6"><label class="form-label">Chẩn đoán</label><textarea name="Diagnosis" class="form-control" rows="3">@Model.Diagnosis</textarea></div>
        <div class="col-md-6"><label class="form-label">Lời dặn</label><textarea name="Instructions" class="form-control" rows="3">@Model.Instructions</textarea></div>
    </div>
    <button type="submit" class="btn-dash btn-dash-primary mt-4"><i class="fas fa-save"></i> Lưu hồ sơ</button>
}
</div></div>
