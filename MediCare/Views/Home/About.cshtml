@{
    ViewBag.Title = "Giới thiệu";
}

<section class="page-banner">
    <div class="container">
        <h1>Về MediCare</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">@Html.ActionLink("Trang chủ", "Index", "Home")</li>
                <li class="breadcrumb-item active" aria-current="page">Giới thiệu</li>
            </ol>
        </nav>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-5 mb-lg-0">
                <img src="https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?w=900&q=80"
                     alt="Về MediCare" style="width: 100%; border-radius: var(--mc-radius-xl); box-shadow: var(--mc-shadow-lg);" />
            </div>
            <div class="col-lg-6 ps-lg-5">
                <span class="badge" style="background: var(--mc-primary-light); color: var(--mc-primary-dark); font-weight: 600; padding: 0.4rem 1rem; border-radius: 999px;">
                    <i class="fas fa-building me-1"></i> VỀ CHÚNG TÔI
                </span>
                <h2 class="mt-3 mb-4">MediCare - <span>Hệ thống y tế hàng đầu</span> Việt Nam</h2>
                <p style="color: var(--mc-gray); margin-bottom: 1rem;">
                    MediCare được thành lập vào năm 2010 với sứ mệnh mang đến dịch vụ y tế chất lượng cao,
                    chi phí hợp lý cho mọi người dân. Sau hơn 15 năm hoạt động, chúng tôi đã trở thành một
                    trong những hệ thống phòng khám đa khoa uy tín hàng đầu tại Việt Nam.
                </p>
                <p style="color: var(--mc-gray); margin-bottom: 1.5rem;">
                    Với đội ngũ 150+ bác sĩ chuyên gia, hệ thống trang thiết bị y tế hiện đại được nhập khẩu
                    từ Đức, Nhật Bản, cùng quy trình khám chữa bệnh theo tiêu chuẩn quốc tế, MediCare cam kết
                    mang đến trải nghiệm chăm sóc sức khỏe tốt nhất cho bạn và gia đình.
                </p>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="info-card">
                            <div class="icon"><i class="fas fa-flag"></i></div>
                            <div>
                                <h5>Sứ mệnh</h5>
                                <p>Chăm sóc sức khỏe toàn diện</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="info-card">
                            <div class="icon"><i class="fas fa-eye"></i></div>
                            <div>
                                <h5>Tầm nhìn</h5>
                                <p>Là top 5 hệ thống y tế Việt Nam</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="section-title">
            <span class="badge"><i class="fas fa-gem me-1"></i> GIÁ TRỊ CỐT LÕI</span>
            <h2>Hành động dựa trên <span>giá trị</span></h2>
            <p>6 giá trị cốt lõi định hình văn hóa và con đường phát triển của MediCare.</p>
        </div>
        <div class="row">
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon"><i class="fas fa-heart"></i></div>
                    <h3>Yêu nghề</h3>
                    <p>Chúng tôi làm việc với trái tim và niềm đam mê dành cho ngành y tế, luôn đặt lợi ích bệnh nhân lên hàng đầu.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon"><i class="fas fa-shield-halved"></i></div>
                    <h3>Chuyên nghiệp</h3>
                    <p>Quy trình khám chữa bệnh tuân thủ nghiêm ngặt tiêu chuẩn quốc tế, đội ngũ được đào tạo bài bản.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon"><i class="fas fa-handshake"></i></div>
                    <h3>Tin cậy</h3>
                    <p>Minh bạch trong chi phí, trung thực trong chẩn đoán, xây dựng lòng tin bền vững từ khách hàng.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon"><i class="fas fa-lightbulb"></i></div>
                    <h3>Đổi mới</h3>
                    <p>Luôn cập nhật công nghệ mới, ứng dụng 4.0 vào quản lý và khám chữa bệnh để tối ưu trải nghiệm.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon"><i class="fas fa-people-group"></i></div>
                    <h3>Đồng đội</h3>
                    <p>Chúng tôi cùng nhau học hỏi, chia sẻ kinh nghiệm, đồng hành cùng nhau trên mọi chặng đường.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon"><i class="fas fa-seedling"></i></div>
                    <h3>Phát triển bền vững</h3>
                    <p>Xây dựng hệ thống y tế chất lượng, đóng góp cho cộng đồng và phát triển ngành y tế Việt Nam.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-title">
            <span class="badge"><i class="fas fa-timeline me-1"></i> HÀNH TRÌNH PHÁT TRIỂN</span>
            <h2>Hành trình <span>15 năm</span> đồng hành</h2>
            <p>Sứ mệnh chăm sóc sức khỏe cộng đồng được xây dựng từng ngày qua từng cột mốc đáng nhớ.</p>
        </div>
        <div class="row">
            <div class="col-lg-10 offset-lg-1">
                <div class="timeline-wrapper" style="position: relative;">
                    <div style="position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; background: var(--mc-gradient); transform: translateX(-50%);"></div>

                    <div class="row mb-5">
                        <div class="col-md-6 text-md-end">
                            <div style="padding-right: 2.5rem;">
                                <strong style="color: var(--mc-primary); font-size: 1.5rem;">2010</strong>
                                <h4 class="mt-2">Thành lập MediCare</h4>
                                <p style="color: var(--mc-gray);">Khánh thành phòng khám đa khoa đầu tiên tại Quận 3, TP. Hồ Chí Minh với 20 bác sĩ và nhân viên.</p>
                            </div>
                        </div>
                        <div class="col-md-6 position-relative">
                            <div style="position: absolute; left: -12px; top: 10px; width: 24px; height: 24px; border-radius: 50%; background: var(--mc-gradient); border: 4px solid #fff; box-shadow: var(--mc-shadow-md);"></div>
                        </div>
                    </div>

                    <div class="row mb-5">
                        <div class="col-md-6"></div>
                        <div class="col-md-6 position-relative">
                            <div style="position: absolute; left: -12px; top: 10px; width: 24px; height: 24px; border-radius: 50%; background: var(--mc-gradient); border: 4px solid #fff; box-shadow: var(--mc-shadow-md);"></div>
                            <div style="padding-left: 2.5rem;">
                                <strong style="color: var(--mc-primary); font-size: 1.5rem;">2015</strong>
                                <h4 class="mt-2">Đạt chứng nhận ISO 9001</h4>
                                <p style="color: var(--mc-gray);">Trở thành phòng khám đầu tiên đạt chứng nhận quản lý chất lượng quốc tế ISO 9001:2015.</p>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-5">
                        <div class="col-md-6 text-md-end">
                            <div style="padding-right: 2.5rem;">
                                <strong style="color: var(--mc-primary); font-size: 1.5rem;">2020</strong>
                                <h4 class="mt-2">Chuyển đổi số 4.0</h4>
                                <p style="color: var(--mc-gray);">Triển khai hệ thống quản lý bệnh án điện tử, đặt lịch online, hệ thống hồ sơ điện tử 100%.</p>
                            </div>
                        </div>
                        <div class="col-md-6 position-relative">
                            <div style="position: absolute; left: -12px; top: 10px; width: 24px; height: 24px; border-radius: 50%; background: var(--mc-gradient); border: 4px solid #fff; box-shadow: var(--mc-shadow-md);"></div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6"></div>
                        <div class="col-md-6 position-relative">
                            <div style="position: absolute; left: -12px; top: 10px; width: 24px; height: 24px; border-radius: 50%; background: var(--mc-gradient); border: 4px solid #fff; box-shadow: var(--mc-shadow-md);"></div>
                            <div style="padding-left: 2.5rem;">
                                <strong style="color: var(--mc-primary); font-size: 1.5rem;">2025</strong>
                                <h4 class="mt-2">Chạm mốc 250K khách hàng</h4>
                                <p style="color: var(--mc-gray);">Hệ thống phát triển với 150+ bác sĩ, phục vụ hơn 250,000 lượt khách hàng mỗi năm.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="section-title">
            <span class="badge"><i class="fas fa-award me-1"></i> CHỨNG NHẬN & GIẢI THƯỞNG</span>
            <h2>Sự <span>công nhận</span> từ cộng đồng</h2>
            <p>Những giải thưởng và chứng nhận là động lực để chúng tôi tiếp tục hoàn thiện chất lượng dịch vụ.</p>
        </div>
        <div class="row">
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="service-card text-center">
                    <div class="service-icon mx-auto mb-3"><i class="fas fa-certificate"></i></div>
                    <h3>ISO 9001:2015</h3>
                    <p>Chứng nhận quản lý chất lượng quốc tế về dịch vụ y tế.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="service-card text-center">
                    <div class="service-icon mx-auto mb-3"><i class="fas fa-medal"></i></div>
                    <h3>Hợp tác BHYT</h3>
                    <p>Cơ sở khám chữa bệnh hợp tác với Bảo hiểm y tế Việt Nam.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="service-card text-center">
                    <div class="service-icon mx-auto mb-3"><i class="fas fa-trophy"></i></div>
                    <h3>Top 10 Y tế</h3>
                    <p>Top 10 hệ thống phòng khám uy tín được bình chọn 5 năm liên tiếp.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="service-card text-center">
                    <div class="service-icon mx-auto mb-3"><i class="fas fa-shield-heart"></i></div>
                    <h3>Thương hiệu tin cậy</h3>
                    <p>Giải thưởng thương hiệu y tế tin dùng của người tiêu dùng.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section pb-0" style="padding-bottom: 5rem !important;">
    <div class="container">
        <div class="cta-section">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-8 mb-4 mb-lg-0">
                        <h2>Bạn muốn trải nghiệm dịch vụ của MediCare?</h2>
                        <p class="mb-0 opacity-9">Đặt lịch ngay hôm nay, nhận ưu đãi 20% cho lần khám đầu tiên!</p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <a href="@Url.Action("Index", "Home")#appointment" class="cta-btn">Đặt lịch miễn phí →</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
