<section id="services" class="section">
    <div class="container">
        <div class="section-title">
            <span class="badge"><i class="fas fa-list-check me-1"></i> Dịch vụ của chúng tôi</span>
            <h2>Trải nghiệm dịch vụ <span>chất lượng cao</span></h2>
            <p>Đầy đủ các dịch vụ y tế từ khám tổng quát đến chuyên khoa sâu, đáp ứng mọi nhu cầu chăm sóc sức khỏe của bạn và gia đình.</p>
        </div>
        <div class="row">
            @if (Model.Services != null && Model.Services.Count > 0)
            {
                foreach (var svc in Model.Services)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="service-card">
                            <div class="service-icon"><i class="@svc.DisplayIcon"></i></div>
                            <h3>@svc.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(svc.Description))
                            {
                                <p>@svc.Description</p>
                            }
                            <div class="d-flex justify-content-between align-items-center">
                                <strong style="color: var(--mc-primary); font-size: 1.1rem;">@svc.DisplayPrice</strong>
                                <a href="#appointment" class="service-link">Đặt lịch →</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-4" style="color: var(--mc-gray);">
                    <i class="fas fa-list-check mb-2" style="font-size: 2rem;"></i>
                    <p class="mb-0">Chưa có dịch vụ nào trong hệ thống.</p>
                </div>
            }
        </div>

        @if (Model.ServiceTotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.ServicePage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@(Url.Action("Index", new { servicePage = Model.ServicePage - 1, doctorPage = Model.DoctorPage }))#services">Trước</a>
                    </li>
                    @for (var p = 1; p <= Model.ServiceTotalPages; p++)
                    {
                        <li class="page-item @(p == Model.ServicePage ? "active" : "")">
                            <a class="page-link" href="@(Url.Action("Index", new { servicePage = p, doctorPage = Model.DoctorPage }))#services">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.ServicePage >= Model.ServiceTotalPages ? "disabled" : "")">
                        <a class="page-link" href="@(Url.Action("Index", new { servicePage = Model.ServicePage + 1, doctorPage = Model.DoctorPage }))#services">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</section>

<section id="doctors" class="section section-alt">
    <div class="container">
        <div class="section-title">
            <span class="badge"><i class="fas fa-user-doctor me-1"></i> Đội ngũ chuyên gia</span>
            <h2>Gặp gỡ các <span>bác sĩ hàng đầu</span></h2>
            <p>Đội ngũ y bác sĩ với hơn 10 năm kinh nghiệm, tốt nghiệp các trường đại học y danh tiếng trong và ngoài nước.</p>
        </div>
        <div class="row">
            @if (Model.DoctorProfiles != null && Model.DoctorProfiles.Count > 0)
            {
                foreach (var doc in Model.DoctorProfiles)
                {
                    var doctorImage = string.IsNullOrWhiteSpace(doc.ImageUrl)
                        ? "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=professional%20portrait%20of%20a%20Vietnamese%20doctor%20wearing%20white%20coat%2C%20friendly%20smile%2C%20bright%20clinic%20background%2C%20realistic%20photo&image_size=portrait_4_3"
                        : doc.ImageUrl;
                    <div class="col-lg-3 col-md-6">
                        <div class="doctor-card">
                            <div class="doctor-img-wrap">
                                <img src="@doctorImage" alt="@doc.FullName" />
                                <div class="doctor-overlay">
                                    <a href="#" title="Facebook"><i class="fab fa-facebook-f"></i></a>
                                    <a href="@doc.DisplayEmail" title="Email"><i class="fas fa-envelope"></i></a>
                                    <a href="#appointment" title="Đặt lịch"><i class="fas fa-calendar-check"></i></a>
                                </div>
                            </div>
                            <div class="doctor-info">
                                <h4>@doc.FullName</h4>
                                <span class="doctor-spec">@doc.DisplayDepartment</span>
                                <div class="doctor-meta">
                                    <span><i class="fas fa-star"></i> @doc.DisplayRating (@doc.DisplayReviewCount)</span>
                                    <span><i class="fas fa-briefcase"></i> @doc.DisplayExperienceYears năm</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(doc.Description))
                                {
                                    <p style="color: var(--mc-gray); font-size: 0.88rem; text-align: left; margin-bottom: 1rem;">
                                        @doc.Description
                                    </p>
                                }
                                <a href="#appointment" class="btn btn-primary btn-sm rounded-pill px-4 w-100">Đặt lịch ngay</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-4" style="color: var(--mc-gray);">
                    <i class="fas fa-user-doctor mb-2" style="font-size: 2rem;"></i>
                    <p class="mb-0">Chưa có bác sĩ nào trong hệ thống.</p>
                </div>
            }
        </div>

        @if (Model.DoctorTotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.DoctorPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@(Url.Action("Index", new { servicePage = Model.ServicePage, doctorPage = Model.DoctorPage - 1 }))#doctors">Trước</a>
                    </li>
                    @for (var p = 1; p <= Model.DoctorTotalPages; p++)
                    {
                        <li class="page-item @(p == Model.DoctorPage ? "active" : "")">
                            <a class="page-link" href="@(Url.Action("Index", new { servicePage = Model.ServicePage, doctorPage = p }))#doctors">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.DoctorPage >= Model.DoctorTotalPages ? "disabled" : "")">
                        <a class="page-link" href="@(Url.Action("Index", new { servicePage = Model.ServicePage, doctorPage = Model.DoctorPage + 1 }))#doctors">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</section>

