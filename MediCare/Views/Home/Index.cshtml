@model MediCare.Models.HomeIndexViewModel
@{
    ViewBag.Title = "Trang chủ";
}

<section id="home" class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="badge" style="background: var(--mc-primary-light); color: var(--mc-primary-dark); padding: 0.45rem 1rem; border-radius: 999px; font-weight: 600; font-size: 0.8rem; letter-spacing: 0.05em;">
                    <i class="fas fa-award me-1"></i> PHÒNG KHÁM UY TÍN HÀNG ĐẦU
                </span>
                <h1 class="mt-3 mb-4">Chăm sóc sức khỏe <span>toàn diện</span><br />với MediCare</h1>
                <p class="lead-text">
                    Hệ thống quản lý phòng khám đa khoa với đội ngũ bác sĩ chuyên gia,
                    trang thiết bị hiện đại và dịch vụ khám chữa bệnh chất lượng cao.
                    Đặt lịch trực tuyến nhanh chóng, hồ sơ bệnh án điện tử an toàn.
                </p>
                <div class="hero-actions">
                    @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Admin hệ thống") || User.IsInRole("Quản lý phòng khám") || User.IsInRole("Bác sĩ")))
                    {
                        if (User.IsInRole("Admin") || User.IsInRole("Admin hệ thống"))
                        {
                            <a href="@Url.Action("Index", "Admin")" class="btn btn-warning px-5 py-3 rounded-pill shadow">
                                <i class="fas fa-shield-halved me-2"></i>Vào Dashboard Admin
                            </a>
                        }
                        else if (User.IsInRole("Quản lý phòng khám"))
                        {
                            <a href="@Url.Action("Index", "ClinicManager")" class="btn btn-success px-5 py-3 rounded-pill shadow">
                                <i class="fas fa-briefcase-medical me-2"></i>Vào Dashboard Quản lý
                            </a>
                        }
                        else if (User.IsInRole("Bác sĩ"))
                        {
                            <a href="@Url.Action("Index", "Doctor")" class="btn btn-info px-5 py-3 rounded-pill shadow text-white">
                                <i class="fas fa-user-md me-2"></i>Vào Dashboard Bác sĩ
                            </a>
                        }
                    }
                    else
                    {
                        <a href="#appointment" class="btn btn-primary px-5 py-3 rounded-pill">
                            <i class="fas fa-calendar-check me-2"></i>Đặt lịch khám ngay
                        </a>
                        <a href="#about" class="btn btn-outline-primary px-5 py-3 rounded-pill">
                            <i class="fas fa-info-circle me-2"></i>Tìm hiểu thêm
                        </a>
                    }
                </div>
                <div class="hero-features">
                    <div class="hero-feature"><i class="fas fa-check"></i> Đặt lịch 24/7</div>
                    <div class="hero-feature"><i class="fas fa-check"></i> Bác sĩ chuyên gia</div>
                    <div class="hero-feature"><i class="fas fa-check"></i> Hồ sơ điện tử</div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-image-wrapper">
                    <img src="https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?w=900&q=80"
                         alt="Đội ngũ bác sĩ MediCare" class="hero-image" />
                    <div class="hero-badge hero-badge-top">
                        <i class="fas fa-calendar-check"></i>
                        <div>
                            <small style="display:block; color: var(--mc-gray); font-size: 0.8rem;">Lượt khám/tháng</small>
                            <strong style="color: var(--mc-dark);">12,500+</strong>
                        </div>
                    </div>
                    <div class="hero-badge hero-badge-bottom">
                        <i class="fas fa-user-md"></i>
                        <div>
                            <small style="display:block; color: var(--mc-gray); font-size: 0.8rem;">Bác sĩ chuyên khoa</small>
                            <strong style="color: var(--mc-dark);">150+ Chuyên gia</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script>
        // @@ts-nocheck
        $(document).ready(function () {
            var initialDoctorId = $('#DoctorId').val() || '';

            $('#DepartmentId').on('change', function () {
                var deptId = $(this).val();
                var $doctorSelect = $('#DoctorId');
                var keepDoctor = initialDoctorId;

                // Clear current options
                $doctorSelect.empty();
                $doctorSelect.append('<option value="">-- Đang tải bác sĩ... --</option>');

                $.ajax({
                    url: '@Url.Action("GetDoctorsByDepartment", "Home")',
                    type: 'GET',
                    data: { departmentId: deptId },
                    success: function (data) {
                        $doctorSelect.empty();
                        $doctorSelect.append('<option value="">-- Bác sĩ bất kỳ --</option>');
                        if (data && data.length > 0) {
                            $.each(data, function (index, item) {
                                $doctorSelect.append('<option value="' + item.id + '">' + item.name + '</option>');
                            });
                        }
                        if (keepDoctor) { $doctorSelect.val(keepDoctor); }
                    },
                    error: function () {
                        $doctorSelect.empty();
                        $doctorSelect.append('<option value="">-- Bác sĩ bất kỳ --</option>');
                        if (keepDoctor) { $doctorSelect.val(keepDoctor); }
                    }
                });
            });

            // Nếu đã có chuyên khoa được chọn (từ AI trợ lý hoặc sau khi submit lỗi), lọc lại danh sách bác sĩ
            if ($('#DepartmentId').val()) {
                $('#DepartmentId').trigger('change');
            }
        });
    </script>
}

