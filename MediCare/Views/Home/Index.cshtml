                            <h5 class="mb-3"><i class="fas fa-clock text-primary me-2"></i>Giờ làm việc</h5>
                            <table class="table table-borderless mb-0">
                                <tbody>
                                    <tr><td style="width: 180px;">Thứ 2 - Thứ 6</td><td style="color: var(--mc-dark); font-weight: 600;">06:30 - 22:00</td></tr>
                                    <tr><td>Thứ 7</td><td style="color: var(--mc-dark); font-weight: 600;">07:00 - 21:00</td></tr>
                                    <tr><td>Chủ nhật</td><td style="color: var(--mc-dark); font-weight: 600;">07:00 - 20:00</td></tr>
                                    <tr><td>Ngày lễ</td><td style="color: var(--mc-secondary); font-weight: 600;"><i class="fas fa-circle-check me-1"></i> Mở cửa bình thường</td></tr>
