                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="info-card">
                    <div class="icon"><i class="fas fa-phone-volume"></i></div>
                    <div>
                        <h5>Điện thoại</h5>
                        <p>Hotline: 1900 1234<br />Fax: (028) 3812 3456</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="info-card">
                    <div class="icon"><i class="fas fa-envelope-open"></i></div>
                    <div>
                        <h5>Email</h5>
                        <p>info@medicare.vn<br />support@medicare.vn</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="appointment-card">
                    <div class="card-header">
                        <h3><i class="fas fa-comment-medical me-2"></i>Gửi tin nhắn cho chúng tôi</h3>
                    </div>
                    <div class="card-body">
                        @using (Html.BeginForm("GuiTinNhanLienHe", "Home", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Họ và tên <span style="color: var(--mc-danger);">*</span></label>
                                    <input type="text" name="HoTen" class="form-control" placeholder="Nhập họ và tên" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Số điện thoại <span style="color: var(--mc-danger);">*</span></label>
                                    <input type="tel" name="SoDienThoai" class="form-control" placeholder="09xx xxx xxx" required />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Email</label>
                                    <input type="email" name="Email" class="form-control" placeholder="example@gmail.com" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Tiêu đề <span style="color: var(--mc-danger);">*</span></label>
                                    <input type="text" name="TieuDe" class="form-control" placeholder="Tiêu đề tin nhắn" required />
