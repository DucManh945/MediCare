                    <div class="stat-content">
                        <strong>150+</strong>
                        <span>Bác sĩ chuyên gia</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="stat-card">
                    <div class="stat-icon bg-2"><i class="fas fa-procedures"></i></div>
                    <div class="stat-content">
                        <strong>250K+</strong>
                        <span>Lượt khám/năm</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="stat-card">
                    <div class="stat-icon bg-3"><i class="fas fa-clinic-medical"></i></div>
                    <div class="stat-content">
                        <strong>30+</strong>
                        <span>Chuyên khoa</span>
                    </div>
                </div>
