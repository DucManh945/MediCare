<section id="appointment" class="section">
    <div class="container">
        <div class="section-title">
            <span class="badge"><i class="fas fa-calendar-plus me-1"></i> ĐẶT LỊCH KHÁM</span>
            <h2>Đặt lịch <span>trực tuyến</span> nhanh chóng</h2>
            <p>Điền thông tin dưới đây để đặt lịch hẹn, chúng tôi sẽ liên hệ xác nhận trong thời gian sớm nhất.</p>
        </div>

        @if (TempData["AppointmentMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <i class="fas fa-circle-check me-2"></i>@TempData["AppointmentMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["AppointmentError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <i class="fas fa-triangle-exclamation me-2"></i>@TempData["AppointmentError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row g-5">
            <div class="col-lg-8">
                <div class="appointment-card">
                    <div class="card-header">
                        <h3 class="mb-0"><i class="fas fa-calendar-plus me-2"></i>Thông tin lịch hẹn</h3>
                    </div>
                    <div class="card-body">
                        @using (Html.BeginForm("DatLichHen", "Home", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <div class="step mb-4">
                                <h5 class="mb-3">
                                    <span class="badge rounded-pill me-2" style="background: var(--mc-gradient);">1</span>
                                    Thông tin bệnh nhân
                                </h5>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Họ và tên <span style="color: var(--mc-danger);">*</span></label>
                                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Nhập họ và tên đầy đủ", required = "required" })
                                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small d-block" })
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Số điện thoại <span style="color: var(--mc-danger);">*</span></label>
                                        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "09xx xxx xxx", required = "required" })
                                        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small d-block" })
                                    </div>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <div class="step mb-4">
                                <h5 class="mb-3">
                                    <span class="badge rounded-pill me-2" style="background: var(--mc-gradient);">2</span>
                                    Thông tin khám
                                </h5>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Chuyên khoa</label>
                                        <select id="DepartmentId" name="DepartmentId" class="form-select">
                                            <option value="">-- Chọn chuyên khoa --</option>
                                            @if (Model != null && Model.Departments != null)
                                            {
                                                foreach (var dept in Model.Departments)
                                                {
                                                    <option value="@dept.MaKhoa" @(Model.DepartmentId == dept.MaKhoa ? "selected" : "")>@dept.TenKhoa</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Chọn bác sĩ (tùy chọn)</label>
                                        <select id="DoctorId" name="DoctorId" class="form-select">
                                            <option value="">-- Bác sĩ bất kỳ --</option>
                                            @if (Model != null && Model.Doctors != null)
                                            {
                                                foreach (var doc in Model.Doctors)
                                                {
                                                    <option value="@doc.UserId" @(Model.DoctorId == doc.UserId ? "selected" : "")>@doc.FullName</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Ngày khám <span style="color: var(--mc-danger);">*</span></label>
                                        <input type="date" name="ExaminationDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@Model.ExaminationDate.ToString("yyyy-MM-dd")" class="form-control" required />
                                        @Html.ValidationMessage("ExaminationDate", "", new { @class = "text-danger small d-block" })
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Giờ khám <span style="color: var(--mc-danger);">*</span></label>
                                        <select name="ExaminationTime" class="form-select" required>
                                            @{
                                                var timeSlots = new[] { "07:00", "07:30", "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "13:30", "14:00", "14:30", "15:00", "15:30", "16:00" };
                                                var selectedTime = string.IsNullOrWhiteSpace(Model.ExaminationTime) ? "08:30" : Model.ExaminationTime;
                                            }
                                            @foreach (var slot in timeSlots)
                                            {
                                                var endTime = DateTime.Today.Add(TimeSpan.Parse(slot)).AddMinutes(30).ToString("HH:mm");
                                                <option value="@slot" @(slot == selectedTime ? "selected" : "")>@slot - @endTime</option>
                                            }
                                        </select>
                                        @Html.ValidationMessage("ExaminationTime", "", new { @class = "text-danger small d-block" })
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label">Triệu chứng / Lý do khám</label>
                                        @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = 3, placeholder = "Mô tả ngắn gọn triệu chứng nếu có hoặc các yêu cầu đặc biệt..." })
                                        @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small d-block" })
                                    </div>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <div class="form-check mb-4">
                                <input class="form-check-input" type="checkbox" id="agree" required checked />
                                <label class="form-check-label" for="agree">
                                    Tôi đã đọc và đồng ý với Điều khoản dịch vụ và Chính sách bảo mật của MediCare.
                                </label>
                            </div>

                            <div class="d-flex gap-3 flex-wrap">
                                <button type="submit" class="btn btn-primary px-5 py-3 rounded-pill flex-grow-1 flex-md-grow-0">
                                    <i class="fas fa-check-circle me-2"></i>Xác nhận đặt lịch
                                </button>
                                <button type="reset" class="btn btn-outline-secondary px-5 py-3 rounded-pill">
                                    <i class="fas fa-rotate-left me-2"></i>Nhập lại
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sticky-top" style="top: 6rem;">
                    <div class="appointment-card mb-4">
                        <div class="card-header">
                            <h3 class="mb-0"><i class="fas fa-circle-info me-2"></i>Lưu ý quan trọng</h3>
                        </div>
                        <div class="card-body">
                            <ul style="padding-left: 1.25rem; margin-bottom: 0;">
                                <li class="mb-2">Hệ thống sẽ gửi tin nhắn SMS xác nhận lịch hẹn đến số điện thoại của bạn trong 30 phút.</li>
                                <li class="mb-2">Vui lòng đến trước 15 phút so với giờ khám đã đăng ký để làm thủ tục.</li>
                                <li class="mb-2">Mang theo Giấy tờ tùy thân, thẻ BHYT (nếu có) và hồ sơ bệnh lý cũ (nếu có).</li>
                                <li class="mb-2">Nếu cần hủy/dời lịch, vui lòng thông báo trước ít nhất 2 giờ qua hotline.</li>
                                <li>Trẻ em dưới 16 tuổi phải có người lớn đi cùng.</li>
                            </ul>
                        </div>
                    </div>

                    <div class="appointment-card mb-4">
                        <div class="card-header">
                            <h3 class="mb-0"><i class="fas fa-phone me-2"></i>Cần hỗ trợ?</h3>
                        </div>
                        <div class="card-body">
                            <div class="info-card mb-3" style="border: none; padding: 0; box-shadow: none;">
                                <div class="icon"><i class="fas fa-headset"></i></div>
                                <div>
                                    <h5>Hotline 24/7</h5>
                                    <p><strong style="color: var(--mc-primary);">1900 1234</strong></p>
                                </div>
                            </div>
                            <div class="info-card mb-3" style="border: none; padding: 0; box-shadow: none;">
                                <div class="icon"><i class="fas fa-envelope"></i></div>
                                <div>
                                    <h5>Email hỗ trợ</h5>
                                    <p>support@medicare.vn</p>
                                </div>
                            </div>
                            <div class="info-card" style="border: none; padding: 0; box-shadow: none;">
                                <div class="icon"><i class="fas fa-comment-dots"></i></div>
                                <div>
                                    <h5>Zalo / Fanpage</h5>
                                    <p>Tìm "MediCare Official"</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="appointment-card">
                        <div class="card-header">
                            <h3 class="mb-0"><i class="fas fa-tags me-2"></i>Ưu đãi đặt lịch</h3>
                        </div>
                        <div class="card-body" style="background: linear-gradient(135deg, #fff7ed, #ecfdf5); border-radius: 0 0 var(--mc-radius-lg) var(--mc-radius-lg);">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span><i class="fas fa-gift me-2 text-warning"></i>Giảm 20%</span>
                                <strong style="color: var(--mc-danger);">Hạn chế</strong>
                            </div>
                            <p class="mb-0" style="font-size: 0.88rem; color: var(--mc-slate-2);">
                                Khách hàng mới đặt lịch online lần đầu được giảm ngay 20% chi phí khám.
                                Chương trình áp dụng đến hết 30/09/2026.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="contact" class="section section-alt">
    <div class="container">
        <div class="section-title">
            <span class="badge"><i class="fas fa-address-book me-1"></i> LIÊN HỆ</span>
            <h2>Thông tin <span>liên hệ</span></h2>
            <p>Liên hệ với chúng tôi để được hỗ trợ nhanh chóng và tận tình.</p>
        </div>

        @if (TempData["ContactMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <i class="fas fa-circle-check me-2"></i>@TempData["ContactMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ContactError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <i class="fas fa-triangle-exclamation me-2"></i>@TempData["ContactError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row g-4 mb-5">
            <div class="col-lg-4 col-md-6">
                <div class="info-card">
                    <div class="icon"><i class="fas fa-map-marker-alt"></i></div>
                    <div>
                        <h5>Địa chỉ</h5>
