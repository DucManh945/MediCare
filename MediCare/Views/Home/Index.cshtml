        </div>
    </div>
</section>

<section class="section pb-0" style="padding-bottom: 5rem !important;">
    <div class="container">
        <div class="cta-section">
            <div class="container">
                <div class="row align-items-center justify-content-between">
                    <div class="col-lg-7 mb-4 mb-lg-0">
                        <h2>Đừng chần chừ, hãy bảo vệ sức khỏe của bạn <span style="font-weight: 400;">hôm nay</span></h2>
                        <p class="mb-0 opacity-9">Đặt lịch hẹn ngay để nhận được chương trình ưu đãi đặc biệt dành cho khách hàng mới!</p>
                    </div>
                    <div class="col-lg-5 text-lg-end">
                        <div class="d-flex gap-2 flex-wrap justify-content-lg-end">
                            <a href="tel:19001234" class="cta-btn">
                                <i class="fas fa-phone-alt"></i> 1900 1234
                            </a>
                            @if (!User.Identity.IsAuthenticated || (!User.IsInRole("Admin") && !User.IsInRole("Admin hệ thống") && !User.IsInRole("Bác sĩ") && !User.IsInRole("Quản lý phòng khám")))
                            {
                                <a href="#appointment" class="cta-btn" style="background: var(--mc-dark); color: #fff !important;">
                                    <i class="fas fa-calendar-check me-2"></i>Đặt lịch ngay
                                </a>
                            }
                            else
                            {
                                <a href="@(User.IsInRole("Admin") || User.IsInRole("Admin hệ thống") ? Url.Action("Index", "Admin") : (User.IsInRole("Bác sĩ") ? Url.Action("Index", "Doctor") : Url.Action("Index", "ClinicManager")))" class="cta-btn" style="background: var(--mc-dark); color: #fff !important;">
                                    <i class="fas fa-gauge-high me-2"></i>Vào Dashboard của bạn
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
