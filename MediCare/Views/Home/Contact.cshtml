@{
    ViewBag.Title = "Liên hệ";
}

<section class="page-banner">
    <div class="container">
        <h1>Liên hệ MediCare</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">@Html.ActionLink("Trang chủ", "Index", "Home")</li>
                <li class="breadcrumb-item active" aria-current="page">Liên hệ</li>
            </ol>
        </nav>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-4 mb-5">
            <div class="col-lg-4 col-md-6">
                <div class="info-card">
                    <div class="icon"><i class="fas fa-map-marker-alt"></i></div>
                    <div>
                        <h5>Địa chỉ</h5>
                        <p>123 Đường 2/4, Phường 6<br />Quận 3, TP. Hồ Chí Minh</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="info-card">
                    <div class="icon"><i class="fas fa-phone-volume"></i></div>
                    <div>
                        <h5>Điện thoại</h5>
                        <p>Hotline: 1900 1234<br />Fax: (028) 3812 3456</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="info-card">
                    <div class="icon"><i class="fas fa-envelope-open"></i></div>
                    <div>
                        <h5>Email</h5>
                        <p>info@medicare.vn<br />support@medicare.vn</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="appointment-card">
                    <div class="card-header">
                        <h3><i class="fas fa-comment-medical me-2"></i>Gửi tin nhắn cho chúng tôi</h3>
                    </div>
                    <div class="card-body">
                        @if (TempData["ContactMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                                <i class="fas fa-circle-check me-2"></i>@TempData["ContactMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        @if (TempData["ContactError"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                                <i class="fas fa-triangle-exclamation me-2"></i>@TempData["ContactError"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @using (Html.BeginForm("GuiTinNhanLienHe", "Home", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="FullName">Họ và tên <span style="color: var(--mc-danger);">*</span></label>
                                    <input type="text" name="HoTen" class="form-control" id="FullName" placeholder="Nhập họ và tên" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="Phone">Số điện thoại <span style="color: var(--mc-danger);">*</span></label>
                                    <input type="tel" name="SoDienThoai" class="form-control" id="Phone" placeholder="09xx xxx xxx" required />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label" for="Email">Email</label>
                                    <input type="email" name="Email" class="form-control" id="Email" placeholder="example@gmail.com" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label" for="Subject">Tiêu đề <span style="color: var(--mc-danger);">*</span></label>
                                    <input type="text" name="TieuDe" class="form-control" id="Subject" placeholder="Tiêu đề tin nhắn" required />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label" for="Message">Nội dung tin nhắn <span style="color: var(--mc-danger);">*</span></label>
                                    <textarea name="NoiDung" class="form-control" id="Message" placeholder="Nhập nội dung bạn muốn gửi..." required></textarea>
                                </div>
                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold">
                                        <i class="fas fa-paper-plane me-2"></i>Gửi tin nhắn
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="appointment-card h-100">
                    <div class="card-header">
                        <h3><i class="fas fa-location-dot me-2"></i>Bản đồ vị trí</h3>
                    </div>
                    <div class="card-body p-0">
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.489899110327!2d106.6855023147391!3d10.776195892296175!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f055c12f12f%3A0xa16fa3bd6abf0e19!2sDistrict%203%2C%20Ho%20Chi%20Minh%20City!5e0!3m2!1sen!2s!4v1715000000000!5m2!1sen!2s"
                            width="100%"
                            height="380"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                        <div class="p-4">
                            <h5 class="mb-3"><i class="fas fa-clock text-primary me-2"></i>Giờ làm việc</h5>
                            <table class="table table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td style="width: 180px;">Thứ 2 - Thứ 6</td>
                                        <td style="color: var(--mc-dark); font-weight: 600;">06:30 - 22:00</td>
                                    </tr>
                                    <tr>
                                        <td>Thứ 7</td>
                                        <td style="color: var(--mc-dark); font-weight: 600;">07:00 - 21:00</td>
                                    </tr>
                                    <tr>
                                        <td>Chủ nhật</td>
                                        <td style="color: var(--mc-dark); font-weight: 600;">07:00 - 20:00</td>
                                    </tr>
                                    <tr>
                                        <td>Ngày lễ</td>
                                        <td style="color: var(--mc-secondary); font-weight: 600;"><i class="fas fa-circle-check me-1"></i> Mở cửa bình thường</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
