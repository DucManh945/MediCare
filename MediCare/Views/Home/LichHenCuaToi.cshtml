@model System.Collections.Generic.List<MediCare.Models.AppointmentItemViewModel>
@{
    ViewBag.Title = "Lịch hẹn của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section" style="padding-top: 3rem;">
    <div class="container">
        <div class="section-title">
            <span class="badge"><i class="fas fa-calendar-day me-1"></i> LỊCH HẸN CỦA TÔI</span>
            <h2>Quản lý <span>lịch hẹn</span> đã đặt</h2>
            <p>Theo dõi và chủ động hủy các lịch hẹn khám mà bạn đã đặt tại MediCare.</p>
        </div>

        @if (TempData["AppointmentMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-circle-check me-2"></i>@TempData["AppointmentMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["AppointmentError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-triangle-exclamation me-2"></i>@TempData["AppointmentError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model == null || Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="fas fa-calendar-xmark fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">Bạn chưa có lịch hẹn nào</h5>
                <p class="text-muted">Hãy đặt lịch khám để được phục vụ tốt nhất.</p>
                <a href="@Url.Action("Index", "Home")#appointment" class="btn btn-primary rounded-pill px-4 mt-2">
                    <i class="fas fa-calendar-plus me-1"></i>Đặt lịch ngay
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle bg-white shadow-sm rounded-3 overflow-hidden">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã</th>
                            <th>Ngày khám</th>
                            <th>Giờ</th>
                            <th>Bác sĩ</th>
                            <th>STT</th>
                            <th>Lý do</th>
                            <th>Trạng thái</th>
                            <th class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var badgeClass = "bg-secondary";
                            if (item.TrangThai == "Đã đặt") { badgeClass = "bg-primary"; }
                            else if (item.TrangThai == "Đã khám") { badgeClass = "bg-success"; }
                            else if (item.TrangThai == "Hủy") { badgeClass = "bg-danger"; }

                            <tr>
                                <td class="ps-4 fw-bold text-primary">#@item.MaLichHen</td>
                                <td>@item.NgayKham.ToString("dd/MM/yyyy")</td>
                                <td>@item.GioKham.ToString(@"hh\:mm")</td>
                                <td>@item.BacSiName</td>
                                <td>@(item.SoThuTu.HasValue ? item.SoThuTu.Value.ToString() : "--")</td>
                                <td class="text-muted small">@(string.IsNullOrWhiteSpace(item.LyDoKham) ? "--" : item.LyDoKham)</td>
                                <td><span class="badge @badgeClass">@item.TrangThai</span></td>
                                <td class="text-center pe-4">
                                    @if (item.TrangThai == "Đã đặt")
                                    {
                                        using (Html.BeginForm("HuyLichHen", "Home", FormMethod.Post, new { onsubmit = "return confirm('Bạn có chắc chắn muốn hủy lịch hẹn #" + item.MaLichHen + "?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.MaLichHen" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                                <i class="fas fa-times me-1"></i>Hủy lịch
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
