@model MediCare.Models.DoctorPrescriptionViewModel
@{
    int from = Model.MedicineTotalItems == 0 ? 0 : (Model.MedicinePage - 1) * Model.MedicinePageSize + 1;
    int to = Math.Min(Model.MedicinePage * Model.MedicinePageSize, Model.MedicineTotalItems);
}

@if (Model.Medicines.Count == 0)
{
    <div class="alert alert-warning mb-0">
        @(string.IsNullOrWhiteSpace(Model.MedicineSearch)
            ? "Kho thuốc hiện không còn thuốc khả dụng."
            : "Không tìm thấy thuốc phù hợp với từ khóa.")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-2">
            <thead class="table-light">
                <tr>
                    <th>Tên thuốc</th>
                    <th>Tồn</th>
                    <th>Đơn giá</th>
                    <th style="width: 90px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var med in Model.Medicines)
                {
                    <tr>
                        <td>
                            <strong>@med.Name</strong>
                            <div class="small text-muted">@med.ActiveIngredient (@med.Unit)</div>
                        </td>
                        <td><span class="badge bg-secondary">@med.Stock</span></td>
                        <td>@med.Price.ToString("N0") đ</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary js-add-med"
                                    data-id="@med.MedicineId"
                                    data-name="@med.Name"
                                    data-unit="@med.Unit"
                                    data-price="@(med.Price.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                                    data-stock="@med.Stock">
                                <i class="fas fa-plus me-1"></i>Thêm
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="small text-muted">Hiển thị @from-@to / @Model.MedicineTotalItems thuốc</div>
        @if (Model.MedicineTotalPages > 1)
        {
            <nav aria-label="Phân trang thuốc">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.MedicinePage <= 1 ? "disabled" : "")">
                        <a class="page-link js-med-page" href="#" data-page="@(Model.MedicinePage - 1)">Trước</a>
                    </li>
                    @for (int p = 1; p <= Model.MedicineTotalPages; p++)
                    {
                        <li class="page-item @(p == Model.MedicinePage ? "active" : "")">
                            <a class="page-link js-med-page" href="#" data-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.MedicinePage >= Model.MedicineTotalPages ? "disabled" : "")">
                        <a class="page-link js-med-page" href="#" data-page="@(Model.MedicinePage + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
