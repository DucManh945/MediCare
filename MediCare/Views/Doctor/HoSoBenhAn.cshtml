@model MediCare.Models.DoctorMedicalRecordViewModel
@{ Layout = "~/Views/Shared/_DashboardLayout.cshtml"; }
@section SidebarNav { @Html.Partial("~/Views/Shared/_DoctorSidebar.cshtml") }
@if (ViewBag.DatabaseError != null) { <div class="alert alert-warning">@ViewBag.DatabaseError</div> }
<div class="row g-4 mb-4"><div class="col-md-3"><div class="stat-box"><div class="stat-box-number">@Model.TotalPatients</div><div class="stat-box-label">Bệnh nhân đã khám</div></div></div><div class="col-md-3"><div class="stat-box"><div class="stat-box-number">@Model.TotalVisits</div><div class="stat-box-label">Tổng lượt khám</div></div></div><div class="col-md-3"><div class="stat-box"><div class="stat-box-number">@Model.CompletedVisits</div><div class="stat-box-label">Phiếu hoàn thành</div></div></div><div class="col-md-3"><div class="stat-box"><div class="stat-box-number">@Model.ActiveVisits</div><div class="stat-box-label">Đang khám</div></div></div></div>
<div class="dash-card"><div class="dash-card-header"><h3 class="dash-card-title"><i class="fas fa-file-medical text-primary me-2"></i>Tra cứu bệnh án</h3></div><div class="dash-card-body"><form method="get" class="row g-2 mb-4"><div class="col-md-9"><input name="search" value="@Model.Search" class="form-control" placeholder="Mã bệnh nhân, họ tên hoặc số điện thoại" /></div><div class="col-md-3"><button class="btn btn-primary w-100"><i class="fas fa-search me-1"></i>Tra cứu</button></div></form><div class="table-responsive"><table class="dash-table"><thead><tr><th>Bệnh nhân</th><th>Liên hệ</th><th>Lần khám gần nhất</th><th>Chẩn đoán gần nhất</th><th>Số lượt</th><th>Trạng thái</th><th></th></tr></thead><tbody>@if (Model.Items.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Không có hồ sơ phù hợp trong phạm vi của bác sĩ.</td></tr> } else { foreach (var item in Model.Items) { <tr><td><strong>@item.PatientName</strong><div class="small text-muted">Mã: @item.PatientId</div></td><td>@item.Phone</td><td>@item.LastVisit.ToString("dd/MM/yyyy HH:mm")</td><td>@(item.Diagnosis ?? "—")</td><td>@item.VisitCount</td><td>@item.Status</td><td><a class="btn btn-sm btn-outline-primary" href="@Url.Action("LichSuKham", new { id = item.PatientId })">Xem lịch sử</a></td></tr> } }</tbody></table></div></div></div>
