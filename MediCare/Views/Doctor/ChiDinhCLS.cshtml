@model MediCare.Models.DoctorClsViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section SidebarNav {
    @Html.Partial("~/Views/Shared/_DoctorSidebar.cshtml")
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (Model.ExaminationId <= 0)
{
    <div class="alert alert-info">
        @(ViewBag.InvalidExaminationId == true ? "Mã phiếu khám không hợp lệ." : "Chưa chọn phiếu khám. Hãy chọn phiếu do bạn phụ trách trước khi tạo chỉ định CLS.")
    </div>
    <a class="btn btn-primary" href="@Url.Action("PhieuKham", new { destination = "ChiDinhCLS" })">Chọn phiếu khám</a>
    <a class="btn btn-outline-secondary ms-2" href="@Url.Action("LichHen")">Quay lại lịch hẹn</a>
}
else
{
    <div class="patient-info-card mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h3 class="text-dark mb-1">@Model.PatientName</h3>
            <div class="text-muted small">
                Mã phiếu khám: @Model.ExaminationId · Mã bệnh nhân: @Model.PatientId · Ngày khám: @Model.ExaminationDate.ToString("dd/MM/yyyy HH:mm") · Trạng thái: @Model.ExaminationStatus
            </div>
        </div>
        <div>
            <a href="@Url.Action("KhamBenh", new { appointmentId = Model.AppointmentId ?? Model.ExaminationId })" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-arrow-left me-1"></i>Quay lại phiếu khám
            </a>
        </div>
    </div>
    if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }
    if (!Model.CanOrder)
    {
        <div class="alert alert-info">Phiếu khám không ở trạng thái Đang khám; không thể tạo thêm chỉ định.</div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="dash-card">
                <div class="dash-card-header">
                    <h3 class="dash-card-title">Danh mục dịch vụ CLS</h3>
                </div>
                <div class="dash-card-body">
                    <div class="list-group">
                        @if (Model.Services.Count == 0)
                        {
                            <div class="text-muted">Chưa có dịch vụ CLS.</div>
                        }
                        else
                        {
                            foreach (var service in Model.Services)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@service.Name</strong>
                                        <div class="small text-muted">@service.Type · @service.Price.ToString("N0")</div>
                                    </div>
                                    @if (Model.CanOrder)
                                    {
                                        using (Html.BeginForm("ChiDinhCLS", "Doctor", FormMethod.Post, new { @class = "ms-2" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="examinationId" value="@Model.ExaminationId" />
                                            <input type="hidden" name="serviceId" value="@service.ServiceId" />
                                            <button class="btn btn-sm btn-outline-primary">Chỉ định</button>
                                        }
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="dash-card">
                <div class="dash-card-header">
                    <h3 class="dash-card-title">Chỉ định và kết quả</h3>
                </div>
                <div class="dash-card-body">
                    @if (Model.Orders.Count == 0)
                    {
                        <div class="text-muted py-3">Chưa có chỉ định CLS.</div>
                    }
                    else
                    {
                        foreach (var order in Model.Orders)
                        {
                            <div class="border rounded p-3 mb-2">
                                <div class="d-flex justify-content-between">
                                    <strong>@order.Name</strong>
                                    <span class="badge bg-secondary">@order.Status</span>
                                </div>
                                <div class="small text-muted">@order.Type · @order.Price.ToString("N0")</div>
                                @if (!string.IsNullOrWhiteSpace(order.Result)) { <div class="mt-2"><strong>Kết quả:</strong> @order.Result</div> }
                                @if (!string.IsNullOrWhiteSpace(order.Conclusion)) { <div><strong>Kết luận:</strong> @order.Conclusion</div> }
                                @if (string.IsNullOrWhiteSpace(order.Result) && string.IsNullOrWhiteSpace(order.Conclusion)) { <div class="small text-muted mt-2">Chưa có kết quả từ bộ phận CLS.</div> }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}
