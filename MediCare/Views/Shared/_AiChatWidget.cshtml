<!-- Floating AI Chat Bubble (Bottom Right Sticky - Stays on Scroll) -->
<div id="aiFloatingWidget" class="ai-sticky-widget">
    <!-- Large Prominent Floating AI Button -->
    <button id="btnAiFloatingBubble" class="ai-sticky-bubble-btn" title="Hỏi AI Triệu Chứng & Gợi Ý Bác Sĩ">
        <div class="ai-sticky-icon">
            <i class="fas fa-robot"></i>
        </div>
        <span class="ai-sticky-text">Hỏi AI</span>
        <span class="ai-pulse-wave"></span>
    </button>

    <!-- Pop-up Chat Window -->
    <div id="aiChatPopUpWindow" class="ai-popup-chat-box d-none">
        <!-- Header -->
        <div class="ai-popup-header">
            <div class="d-flex align-items-center gap-2">
                <div class="ai-avatar-lg">
                    <i class="fas fa-user-doctor"></i>
                    <span class="online-indicator"></span>
                </div>
                <div>
                    <h6 class="ai-popup-title mb-0">MediCare AI Assistant <i class="fas fa-sparkles text-warning ms-1"></i></h6>
                    <small class="ai-popup-subtitle">Tư vấn triệu chứng & Gợi ý Bác sĩ (OpenAI)</small>
                </div>
            </div>
            <button id="btnCloseAiPopUpWindow" class="btn-close-popup" title="Đóng chat" onclick="closeAiPopUpWindowExplicit(event)">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Chat Body -->
        <div id="aiPopUpBody" class="ai-popup-body">
            <div class="chat-msg bot-msg">
                <div class="bot-avatar"><i class="fas fa-robot"></i></div>
                <div class="msg-content">
                    <p class="mb-2"><strong>Xin chào! Tôi là Trợ lý AI MediCare 👋</strong></p>
                    <p class="mb-2">Bạn đang gặp triệu chứng gì về sức khỏe? Hãy mô tả triệu chứng, tôi sẽ phân tích & gợi ý Bác sĩ / Chuyên khoa phù hợp nhất từ hệ thống!</p>
                    <div class="quick-symptoms mt-2">
                        <small class="text-muted d-block mb-1 font-weight-bold"><i class="fas fa-bolt text-warning me-1"></i>Gợi ý triệu chứng nhanh:</small>
                        <div class="d-flex flex-wrap gap-1">
                            <button class="btn-symptom-tag" data-symptom="Sốt cao, đau họng, ho có đờm">Sốt & Đau họng</button>
                            <button class="btn-symptom-tag" data-symptom="Đau dạ dày, đầy hơi, buồn nôn">Đau dạ dày</button>
                            <button class="btn-symptom-tag" data-symptom="Đau đầu, chóng mặt, ù tai">Đau đầu</button>
                            <button class="btn-symptom-tag" data-symptom="Đau tức ngực, khó thở nặng">Đau ngực (Cấp cứu)</button>
                            <button class="btn-symptom-tag" data-symptom="Đau nhức xương khớp, mỏi vai gáy">Xương khớp</button>
                        </div>
                    </div>
                </div>
            </div>
            <div id="aiPopUpMsgList" class="d-flex flex-column gap-2 mt-2"></div>
        </div>

        <!-- Footer / Input -->
        <div class="ai-popup-footer">
            <form id="aiPopUpForm" class="d-flex align-items-center gap-2">
                @Html.AntiForgeryToken()
                <input type="text" id="aiPopUpInput" class="form-control ai-popup-input py-2" placeholder="Mô tả triệu chứng (VD: Sốt 38.5度, ho...)" autocomplete="off" required />
                <button type="submit" id="btnSendAiForm" class="btn btn-primary btn-send-popup px-3" title="Gửi">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </form>
            <div class="text-center mt-2">
                <small class="text-muted" style="font-size:0.7rem;">
                    <i class="fas fa-shield-halved me-1 text-success"></i>Tư vấn AI mang tính tham khảo. Khám bác sĩ trực tiếp để chẩn đoán chính xác.
                </small>
            </div>
        </div>
    </div>
</div>

<style>
/* Sticky Floating AI Bubble (Bottom Right) */
.ai-sticky-widget {
    position: fixed !important;
    right: 25px !important;
    bottom: 25px !important;
    z-index: 9999 !important;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
}

.ai-sticky-bubble-btn {
    position: relative !important;
    width: 76px !important;
    height: 76px !important;
    border-radius: 50% !important;
    background: linear-gradient(135deg, #0ea5e9 0%, #10b981 100%) !important;
    border: 3px solid #ffffff !important;
    color: #ffffff !important;
    box-shadow: 0 10px 30px rgba(14, 165, 233, 0.55) !important;
    cursor: pointer !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    outline: none !important;
}

.ai-sticky-bubble-btn:hover {
    transform: scale(1.1) translateY(-3px) !important;
    box-shadow: 0 15px 35px rgba(14, 165, 233, 0.7) !important;
}

.ai-sticky-icon {
    font-size: 1.7rem !important;
    line-height: 1 !important;
}

.ai-sticky-text {
    font-size: 0.7rem !important;
    font-weight: 800 !important;
    margin-top: 2px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.03em !important;
    color: #ffffff !important;
}

.ai-pulse-wave {
    position: absolute !important;
    top: -6px !important;
    left: -6px !important;
    right: -6px !important;
    bottom: -6px !important;
    border-radius: 50% !important;
    border: 2px solid #0ea5e9 !important;
    animation: pulseWave 2s infinite cubic-bezier(0.4, 0, 0.6, 1) !important;
    opacity: 0.7 !important;
    pointer-events: none !important;
}

@@keyframes pulseWave {
    0% { transform: scale(0.95); opacity: 0.8; }
    100% { transform: scale(1.35); opacity: 0; }
}

/* Pop-up Chat Window */
.ai-popup-chat-box {
    position: absolute !important;
    bottom: 90px !important;
    right: 0 !important;
    width: 380px !important;
    max-width: calc(100vw - 30px) !important;
    height: 520px !important;
    max-height: calc(100vh - 120px) !important;
    background: #ffffff !important;
    border-radius: 20px !important;
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.25) !important;
    border: 1px solid rgba(226, 232, 240, 0.9) !important;
    overflow: hidden !important;
    animation: popUpSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
    transform-origin: bottom right !important;
}

.ai-popup-chat-box.d-none {
    display: none !important;
}

.ai-popup-chat-box:not(.d-none) {
    display: flex !important;
    flex-direction: column !important;
}

@@keyframes popUpSlideIn {
    from { opacity: 0; transform: translateY(20px) scale(0.9); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

.ai-popup-header {
    background: linear-gradient(135deg, #0f172a 0%, #0284c7 100%) !important;
    color: #ffffff !important;
    padding: 0.95rem 1.15rem !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
}

.ai-avatar-lg {
    width: 40px !important;
    height: 40px !important;
    border-radius: 50% !important;
    background: linear-gradient(135deg, #0ea5e9, #10b981) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 1.15rem !important;
    color: #fff !important;
    position: relative !important;
}

.online-indicator {
    position: absolute !important;
    bottom: 2px !important;
    right: 2px !important;
    width: 10px !important;
    height: 10px !important;
    background: #10b981 !important;
    border: 2px solid #0f172a !important;
    border-radius: 50% !important;
}

.ai-popup-title {
    font-size: 0.95rem !important;
    font-weight: 800 !important;
    color: #ffffff !important;
}

.ai-popup-subtitle {
    font-size: 0.72rem !important;
    color: #94a3b8 !important;
}

.btn-close-popup {
    background: transparent !important;
    border: none !important;
    color: #cbd5e1 !important;
    font-size: 1.3rem !important;
    cursor: pointer !important;
    padding: 2px 8px !important;
    line-height: 1 !important;
}

.btn-close-popup:hover { color: #ffffff !important; }

.ai-popup-body {
    flex: 1 !important;
    padding: 1rem !important;
    overflow-y: auto !important;
    background: #f8fafc !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.85rem !important;
}

.ai-popup-footer {
    padding: 0.8rem 1rem !important;
    background: #ffffff !important;
    border-top: 1px solid #e2e8f0 !important;
}

.ai-popup-input {
    border-radius: 20px !important;
    padding-left: 1rem !important;
    font-size: 0.88rem !important;
    border: 1px solid #cbd5e1 !important;
}

.btn-send-popup {
    border-radius: 20px !important;
    font-weight: 600 !important;
}

.typing-dots span {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0ea5e9;
    margin: 0 2px;
    animation: typingBounce 1.4s infinite ease-in-out both;
}
.typing-dots span:nth-child(1) { animation-delay: -0.32s; }
.typing-dots span:nth-child(2) { animation-delay: -0.16s; }

@@keyframes typingBounce {
    0%, 80%, 100% { transform: scale(0); }
    40% { transform: scale(1); }
}
</style>

<script>
window.closeAiPopUpWindowExplicit = function (e) {
    if (e) {
        e.preventDefault();
        e.stopPropagation();
    }
    var popup = document.getElementById('aiChatPopUpWindow');
    if (popup) {
        popup.classList.add('d-none');
        popup.style.setProperty('display', 'none', 'important');
    }
};

document.addEventListener('DOMContentLoaded', function () {
    var $btnToggle = document.getElementById('btnAiFloatingBubble');
    var $popupWindow = document.getElementById('aiChatPopUpWindow');
    var $btnClose = document.getElementById('btnCloseAiPopUpWindow');
    var $form = document.getElementById('aiPopUpForm');
    var $input = document.getElementById('aiPopUpInput');
    var $msgList = document.getElementById('aiPopUpMsgList');
    var $body = document.getElementById('aiPopUpBody');
    var $btnSend = document.getElementById('btnSendAiForm');

    if (!$btnToggle || !$popupWindow) return;

    var chatHistory = [];

    $btnToggle.addEventListener('click', function (e) {
        e.preventDefault();
        if ($popupWindow.classList.contains('d-none')) {
            $popupWindow.classList.remove('d-none');
            $popupWindow.style.setProperty('display', 'flex', 'important');
            $input.focus();
            scrollToBottom();
        } else {
            $popupWindow.classList.add('d-none');
            $popupWindow.style.setProperty('display', 'none', 'important');
        }
    });

    if ($btnClose) {
        $btnClose.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $popupWindow.classList.add('d-none');
            $popupWindow.style.setProperty('display', 'none', 'important');
        });
    }

    document.addEventListener('click', function (e) {
        if (e.target && e.target.classList.contains('btn-symptom-tag')) {
            var symptom = e.target.getAttribute('data-symptom') || e.target.innerText;
            processPopUpSymptom(symptom);
        }
    });

    $form.addEventListener('submit', function (e) {
        e.preventDefault();
        var val = $input.value.trim();
        if (!val) return;
        $input.value = '';
        processPopUpSymptom(val);
    });

    // @@ts-nocheck
    function processPopUpSymptom(text) {
        appendUserMsg(text);
        chatHistory.push({ Sender: 'user', Message: text });

        var typingId = appendTypingIndicator();
        scrollToBottom();

        $btnSend.disabled = true;
        var token = $('input[name="__RequestVerificationToken"]', $form).val();

        $.ajax({
            url: '@Url.Action("ProcessSymptom", "Ai")',
            type: 'POST',
            data: {
                __RequestVerificationToken: token,
                SymptomText: text,
                History: chatHistory
            },
            success: function (res) {
                removeTyping(typingId);
                $btnSend.disabled = false;

                if (res && res.Success) {
                    renderServerAiResponse(res);
                    chatHistory.push({ Sender: 'assistant', Message: res.DiagnosisSummary });
                } else {
                    appendBotMsg('<p class="text-danger mb-0"><i class="fas fa-exclamation-triangle me-1"></i>' + escapeHtml(res ? res.ErrorMessage : 'Không thể kết nối AI.') + '</p>');
                }
                scrollToBottom();
            },
            error: function () {
                removeTyping(typingId);
                $btnSend.disabled = false;
                appendBotMsg('<p class="text-danger mb-0"><i class="fas fa-exclamation-circle me-1"></i>Lỗi kết nối máy chủ AI. Vui lòng thử lại sau.</p>');
                scrollToBottom();
            }
        });
    }

    function appendUserMsg(text) {
        var html = '<div class="chat-msg user-msg ms-auto">' +
            '<div class="msg-content bg-primary text-white p-2 rounded-3 text-wrap" style="max-width:85%; font-size:0.88rem;">' + escapeHtml(text) + '</div>' +
            '</div>';
        $msgList.insertAdjacentHTML('beforeend', html);
    }

    function appendBotMsg(htmlContent) {
        var html = '<div class="chat-msg bot-msg">' +
            '<div class="bot-avatar"><i class="fas fa-robot"></i></div>' +
            '<div class="msg-content bg-white p-2 rounded-3 border text-wrap" style="max-width:90%; font-size:0.85rem;">' + htmlContent + '</div>' +
            '</div>';
        $msgList.insertAdjacentHTML('beforeend', html);
    }

    function appendTypingIndicator() {
        var id = 'typing_' + Date.now();
        var html = '<div id="' + id + '" class="chat-msg bot-msg">' +
            '<div class="bot-avatar"><i class="fas fa-robot"></i></div>' +
            '<div class="msg-content p-2 bg-white rounded-3 border">' +
            '<div class="typing-dots"><span></span><span></span><span></span></div>' +
            '</div>' +
            '</div>';
        $msgList.insertAdjacentHTML('beforeend', html);
        return id;
    }

    function removeTyping(id) {
        var el = document.getElementById(id);
        if (el) el.remove();
    }

    function renderServerAiResponse(res) {
        var html = '';

        if (res.IsEmergency) {
            html += '<div class="alert alert-danger p-2 mb-2 font-weight-bold" style="font-size:0.85rem;">' +
                '<i class="fas fa-triangle-exclamation fs-5 me-2"></i>' + escapeHtml(res.DiagnosisSummary) +
                '</div>' +
                '<p class="text-danger mb-2 font-weight-bold">' + escapeHtml(res.HealthAdvice) + '</p>';
            appendBotMsg(html);
            return;
        }

        var offlineBadge = res.IsOfflineFallback
            ? ' <span class="badge bg-warning text-dark" style="font-size:0.65rem;" title="Chưa cấu hình API Key nên dùng bộ luật chẩn đoán cục bộ">Chế độ offline</span>'
            : '';

        html += '<p class="mb-1 font-weight-bold text-dark"><i class="fas fa-microscope text-primary me-1"></i>Phân tích Y khoa (AI):' + offlineBadge + '</p>' +
            '<p class="mb-2 text-secondary" style="font-size:0.83rem;">' + escapeHtml(res.DiagnosisSummary) + '</p>' +
            '<div class="p-2 border rounded bg-light mb-2">' +
            '<div class="mb-1"><strong>Chuyên khoa:</strong> <span class="badge bg-primary">' + escapeHtml(res.DepartmentName) + '</span></div>' +
            '<div class="text-muted" style="font-size:0.78rem;"><em>' + escapeHtml(res.HealthAdvice) + '</em></div>' +
            '</div>';

        if (res.RecommendedDoctors && res.RecommendedDoctors.length > 0) {
            html += '<div class="mt-2"><strong class="small text-dark d-block mb-1"><i class="fas fa-user-doctor text-success me-1"></i>Bác sĩ gợi ý từ CSDL:</strong>';
            $.each(res.RecommendedDoctors, function (i, doc) {
                var deptId = res.DepartmentId || doc.DepartmentId || '';
                html += '<div class="d-flex justify-content-between align-items-center p-2 mb-1 bg-white border rounded shadow-sm">' +
                    '<div>' +
                    '<div class="fw-bold text-primary" style="font-size:0.82rem;">' + escapeHtml(doc.DoctorName) + '</div>' +
                    '<div class="text-muted" style="font-size:0.72rem;">' + escapeHtml(doc.DepartmentName) + '</div>' +
                    '</div>' +
                    '<button type="button" class="btn btn-sm btn-success rounded-pill px-2 py-1 font-weight-bold btn-ai-book" style="font-size:0.75rem;"' +
                    ' data-doctor-id="' + escapeAttr(doc.DoctorId) + '"' +
                    ' data-department-id="' + escapeAttr(deptId) + '"' +
                    ' data-reason="' + escapeAttr(res.SuggestedReason || '') + '">' +
                    '<i class="fas fa-calendar-check me-1"></i>Đặt lịch' +
                    '</button>' +
                    '</div>';
            });
            html += '</div>';
        }

        appendBotMsg(html);
    }

    function scrollToBottom() {
        $body.scrollTop = $body.scrollHeight;
    }

    function escapeHtml(text) {
        if (!text) return '';
        var div = document.createElement('div');
        div.innerText = text;
        return div.innerHTML;
    }

    function escapeAttr(text) {
        if (text === null || text === undefined) return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    // Bấm nút "Đặt lịch" trong khung chat AI
    $msgList.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-ai-book');
        if (!btn) return;
        selectDoctorAndBook(
            btn.getAttribute('data-doctor-id'),
            btn.getAttribute('data-department-id'),
            btn.getAttribute('data-reason')
        );
    });

    function closePopUp() {
        $popupWindow.classList.add('d-none');
        $popupWindow.style.setProperty('display', 'none', 'important');
    }

    /**
     * Chuyển tới khu vực đặt lịch và tự động điền sẵn khoa / bác sĩ / lý do khám.
     * Nếu đang ở trang chủ (có sẵn form đặt lịch) thì điền trực tiếp; nếu ở trang khác
     * thì điều hướng về trang chủ kèm tham số để form tự điền.
     */
    function selectDoctorAndBook(doctorId, departmentId, reason) {
        closePopUp();

        var deptSelect = document.querySelector('select[name="DepartmentId"]');
        var doctorSelect = document.querySelector('select[name="DoctorId"]');
        var reasonInput = document.querySelector('textarea[name="Reason"]');
        var appSec = document.getElementById('appointment');

        if (deptSelect && doctorSelect && appSec) {
            if (departmentId) deptSelect.value = String(departmentId);
            if (doctorId) doctorSelect.value = String(doctorId);
            if (reason && reasonInput) reasonInput.value = reason;
            appSec.scrollIntoView({ behavior: 'smooth' });
            return;
        }

        var url = '@Url.Action("Index", "Home")' +
            '?prefillDepartmentId=' + encodeURIComponent(departmentId || '') +
            '&prefillDoctorId=' + encodeURIComponent(doctorId || '') +
            '&prefillReason=' + encodeURIComponent(reason || '') +
            '#appointment';
        window.location.href = url;
    }

    window.selectDoctorAndBook = selectDoctorAndBook;
});
</script>
