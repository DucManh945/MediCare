<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MediCare Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="dashboard-body">
    <div class="dashboard-wrapper">
        <aside class="dashboard-sidebar">
            <div class="sidebar-header">
                <a href="@Url.Action("Index", "Home")" class="d-flex align-items-center gap-2 text-decoration-none">
                    <div class="sidebar-logo-icon">
                        <i class="fas fa-heartbeat"></i>
                    </div>
                    <div>
                        <span class="sidebar-logo-primary">Medi</span><span class="sidebar-logo-secondary">Care</span>
                        <small class="sidebar-role">@ViewBag.RoleName</small>
                    </div>
                </a>
            </div>
            <nav class="sidebar-nav" aria-label="Điều hướng quản lý">
                @RenderSection("SidebarNav", required: false)
            </nav>
            <div class="sidebar-footer">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="sidebar-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <div style="flex:1; min-width:0;">
                        <div class="sidebar-user-name">@ViewBag.UserName</div>
                        <div class="sidebar-user-role">@ViewBag.RoleName</div>
                    </div>
                </div>
                <form method="post" action="@Url.Action("LogoutPost", "Account")" class="w-100" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-logout w-100" aria-label="Đăng xuất">
                        <i class="fas fa-right-from-bracket me-2"></i>Đăng xuất
                    </button>
                </form>
            </div>
        </aside>

        <div class="dashboard-main">
            <header class="dashboard-topbar">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn-topbar-icon sidebar-toggle d-lg-none" title="Mở menu">
                            <i class="fas fa-bars"></i>
                        </button>
                        <div>
                            <h1 class="topbar-title mb-0">@ViewBag.PageTitle</h1>
                            <div class="topbar-breadcrumb">
                                <i class="fas fa-home me-1"></i>
                                @Html.ActionLink("Trang chủ", "Index", "Home")
                                <span class="mx-2">/</span>
                                <span>@ViewBag.PageTitle</span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <a href="@Url.Action("TwoFactorSetup", "Account")" class="btn-topbar-icon" title="Bảo mật tài khoản &amp; Xác thực 2FA">
                            <i class="fas fa-shield-halved"></i>
                        </a>
                        <div class="topbar-user">
                            <div class="sidebar-avatar" style="width:40px; height:40px; font-size:0.95rem;">
                                <i class="fas fa-user"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <main class="dashboard-content">
                @RenderBody()
            </main>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    <style>
        .dashboard-sidebar .sidebar-nav {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: .35rem;
            width: 100%;
        }
        .dashboard-sidebar .sidebar-nav > .sidebar-nav-item {
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            width: 100%;
            min-height: 44px;
            box-sizing: border-box;
            padding: .7rem 1rem;
            gap: .75rem;
            white-space: nowrap;
            line-height: 1.25;
            text-decoration: none;
        }
        .dashboard-sidebar .sidebar-nav > .sidebar-nav-item > i {
            flex: 0 0 1.25rem;
            width: 1.25rem;
            text-align: center;
        }
        .dashboard-sidebar .sidebar-nav > .sidebar-nav-item > span {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    </style>
    <script>
        // @@ts-nocheck
        $(document).ready(function() {
            $.ajax({
                url: '@Url.Action("DemThongBaoChuaDoc", "Home")',
                type: 'GET',
                cache: false,
                success: function(data) {
                    if (data && data.unread !== undefined) {
                        $('#unreadNotifCount').text(data.unread);
                    }
                }
            });
        });
    </script>
</body>
</html>
