@model MediCare.Models.SecurityManagementViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section SidebarNav {
    @Html.Partial("~/Views/Shared/_AdminSidebar.cshtml")
}

@if (TempData["SecurityMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4"><i class="fas fa-circle-check me-2"></i>@TempData["SecurityMessage"]</div>
}
@if (TempData["SecurityError"] != null || ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4"><i class="fas fa-triangle-exclamation me-2"></i>@(TempData["SecurityError"] ?? ViewBag.Error)</div>
}

<!-- Security Card -->
<div class="dash-card">
    <div class="dash-card-header d-flex justify-content-between align-items-center">
        <h3 class="dash-card-title mb-0">
            <i class="fas fa-shield-halved text-danger me-2"></i>
            Tình trạng Bảo mật & Cảnh báo An ninh Hệ thống (CSDL Thực tế)
        </h3>
        <span class="badge @(Model != null && Model.IsHttps ? "bg-success" : "bg-warning text-dark")">
            @(Model != null && Model.IsHttps ? "HTTPS: Đã kích hoạt" : "HTTP: Cảnh báo chưa dùng HTTPS")
        </span>
    </div>

    <div class="dash-card-body">
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="p-3 border rounded bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="text-dark"><i class="fas fa-lock text-primary me-2"></i>Chứng chỉ SSL/TLS</strong>
                        <span class="badge @(Model != null && Model.IsHttps ? "bg-success" : "bg-secondary")">@(Model != null && Model.IsHttps ? "Active" : "Standard")</span>
                    </div>
                    <div class="small text-muted">Giao thức truy cập hiện tại: <strong>@(Model != null && Model.IsHttps ? "HTTPS (Secure)" : "HTTP")</strong></div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-3 border rounded bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="text-dark"><i class="fas fa-key text-warning me-2"></i>Xác thực 2 yếu tố (2FA)</strong>
                        <span class="badge @(Model != null && Model.TwoFactorEnabledCount > 0 ? "bg-success" : "bg-warning text-dark")">
                            @(Model != null && Model.TwoFactorEnabledCount > 0 ? "Đã triển khai" : "Chưa cấu hình")
                        </span>
                    </div>
                    <div class="small text-muted">Trạng thái: <strong>@Model.TwoFactorStatus</strong></div>
                    <div class="small mt-1"><a href="@Url.Action("TwoFactorSetup", "Account")"><i class="fas fa-shield-halved me-1"></i>Thiết lập 2FA cho tài khoản của bạn</a></div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-3 border rounded bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="text-dark"><i class="fas fa-ban text-danger me-2"></i>Firewall IP Blocking</strong>
                        <span class="badge bg-danger">@Model.BlockedIpCount IPs Blocked</span>
                    </div>
                    <div class="small text-muted">Tự động chặn IP nếu đăng nhập thất bại liên tiếp</div>
                </div>
            </div>
        </div>

        <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
            <i class="fas fa-ban text-danger me-2"></i>Danh sách IP đang bị khóa tạm thời (Firewall Blacklist từ CSDL)
        </h5>

        <div class="table-responsive">
            <table class="dash-table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>Địa chỉ IP</th>
                        <th>Lý do khóa</th>
                        <th>Thời gian khóa</th>
                        <th>Thời hạn mở</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.BlockedIps != null && Model.BlockedIps.Count > 0)
                    {
                        foreach (var ip in Model.BlockedIps)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-danger">@ip.IpAddress</td>
                                <td>@ip.Reason</td>
                                <td class="small">@ip.LockedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="small">@(ip.ExpiresAt?.ToString("dd/MM/yyyy HH:mm") ?? "Vô thời hạn")</td>
                                <td class="text-center">
                                    @using (Html.BeginForm("MoKhoaIp", "Admin", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", ip.Id)
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            <i class="fas fa-unlock me-1"></i>Mở khóa IP
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">Không có địa chỉ IP nào đang bị khóa trong firewall.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
