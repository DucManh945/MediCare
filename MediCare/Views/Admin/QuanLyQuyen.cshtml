@model MediCare.Models.RoleManagementViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section SidebarNav {
    @Html.Partial("~/Views/Shared/_AdminSidebar.cshtml")
}

@if (TempData["RoleMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4"><i class="fas fa-circle-check me-2"></i>@TempData["RoleMessage"]</div>
}
@if (TempData["RoleError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4"><i class="fas fa-triangle-exclamation me-2"></i>@TempData["RoleError"]</div>
}

<div class="row g-4">
    <!-- Danh sách Vai trò -->
    <div class="col-lg-8">
        <div class="dash-card">
            <div class="dash-card-header d-flex justify-content-between align-items-center">
                <h3 class="dash-card-title mb-0">
                    <i class="fas fa-user-shield text-primary me-2"></i>
                    Quản lý Vai trò & Phân quyền Truy cập (RBAC từ CSDL)
                </h3>
            </div>

            <div class="dash-card-body p-0">
                <div class="table-responsive">
                    <table class="dash-table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Mã Role</th>
                                <th>Tên Vai trò</th>
                                <th>Mô tả chức năng</th>
                                <th class="text-center">Số người dùng</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Roles != null)
                            {
                                foreach (var role in Model.Roles)
                                {
                                    <tr>
                                        <td><strong class="text-primary">#@role.RoleId</strong></td>
                                        <td><strong class="text-dark">@role.RoleName</strong></td>
                                        <td class="small text-muted">@role.Description</td>
                                        <td class="text-center fw-bold">@role.UserCount</td>
                                        <td class="text-center">
                                            <span class="badge-pill @(role.IsSystemRole ? "badge-success" : "badge-info")">
                                                @(role.IsSystemRole ? "Hệ thống" : "Tùy chỉnh")
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-primary me-1" data-bs-toggle="modal" data-bs-target="#editRoleModal@(role.RoleId)" title="Sửa vai trò">
                                                <i class="fas fa-pen"></i> Sửa
                                            </button>
                                            @if (!role.IsSystemRole)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteRoleModal@(role.RoleId)" title="Xóa vai trò">
                                                    <i class="fas fa-trash"></i> Xóa
                                                </button>

                                                <!-- Modal Xóa Role -->
                                                <div class="modal fade text-start" id="deleteRoleModal@(role.RoleId)" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            @using (Html.BeginForm("XoaRole", "Admin", FormMethod.Post))
                                                            {
                                                                @Html.AntiForgeryToken()
                                                                @Html.Hidden("roleId", role.RoleId)
                                                                <div class="modal-header bg-danger text-white">
                                                                    <h5 class="modal-title"><i class="fas fa-triangle-exclamation me-2"></i>Xác nhận Xóa Vai trò</h5>
                                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                </div>
                                                                <div class="modal-body text-start">
                                                                    <p>Bạn có chắc chắn muốn xóa vai trò tùy chỉnh: <strong class="text-danger">@role.RoleName</strong>?</p>
                                                                    <p class="small text-muted mb-0">Thao tác này chỉ thực hiện được nếu không có tài khoản nào đang liên kết sử dụng.</p>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                                                                    <button type="submit" class="btn btn-danger btn-sm fw-bold">Xác nhận Xóa</button>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            <!-- Modal Sửa Role -->
                                            <div class="modal fade text-start" id="editRoleModal@(role.RoleId)" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        @using (Html.BeginForm("SuaRole", "Admin", FormMethod.Post))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            @Html.Hidden("RoleId", role.RoleId)
                                                            <div class="modal-header">
                                                                <h5 class="modal-title">Chỉnh sửa Vai trò: @role.RoleName</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body text-start">
                                                                <div class="mb-3">
                                                                    <label class="form-label font-weight-semibold">Tên Vai trò:</label>
                                                                    <input type="text" name="RoleName" class="form-control" value="@role.RoleName" @(role.IsSystemRole ? "readonly" : "") required />
                                                                    @if (role.IsSystemRole) {
                                                                        <small class="text-muted">Vai trò hệ thống cốt lõi không được đổi tên.</small>
                                                                    }
                                                                </div>
                                                                <div class="mb-3">
                                                                    <label class="form-label font-weight-semibold">Mô tả chức năng:</label>
                                                                    <textarea name="Description" class="form-control" rows="3">@role.Description</textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                                                                <button type="submit" class="btn btn-primary btn-sm fw-bold">Lưu thay đổi</button>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Thêm Vai trò mới -->
    <div class="col-lg-4">
        <div class="dash-card">
            <div class="dash-card-header">
                <h3 class="dash-card-title mb-0"><i class="fas fa-plus-circle text-success me-2"></i>Thêm Vai trò mới</h3>
            </div>
            <div class="dash-card-body">
                @using (Html.BeginForm("ThemRole", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Tên Vai trò (Role Name):</label>
                        @Html.TextBoxFor(m => m.NewRole.RoleName, new { @class = "form-control", placeholder = "Ví dụ: Lễ tân, Thu ngân..." })
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Mô tả chức năng:</label>
                        @Html.TextAreaFor(m => m.NewRole.Description, new { @class = "form-control", rows = 3, placeholder = "Mô tả quyền hạn..." })
                    </div>
                    <button type="submit" class="btn btn-success w-100 fw-bold py-2">
                        <i class="fas fa-save me-1"></i> Tạo Vai trò
                    </button>
                }
            </div>
        </div>
    </div>
</div>
