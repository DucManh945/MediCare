@model MediCare.Models.AdminDashboardViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var total = Model != null && Model.TotalUsers > 0 ? Model.TotalUsers : 1;
    var pPct = Math.Round((double)(Model?.PatientCount ?? 0) * 100 / total, 1);
    var dPct = Math.Round((double)(Model?.DoctorCount ?? 0) * 100 / total, 1);
    var mPct = Math.Round((double)(Model?.ManagerCount ?? 0) * 100 / total, 1);
    var sPct = Math.Round((double)(Model?.StaffCount ?? 0) * 100 / total, 1);
    var aPct = Math.Round((double)(Model?.AdminCount ?? 0) * 100 / total, 1);
}

@section SidebarNav {
    @Html.Partial("~/Views/Shared/_AdminSidebar.cshtml")
}

<div class="row g-4 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="stat-box">
            <div class="stat-box-icon purple">
                <i class="fas fa-hospital-user"></i>
            </div>
            <div>
                <span class="stat-box-number">@(Model?.TotalUsers ?? 0)</span>
                <span class="stat-box-label">Tổng người dùng (CSDL)</span>
                <span class="stat-box-change up"><i class="fas fa-check me-1"></i>Hoạt động</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-box">
            <div class="stat-box-icon blue">
                <i class="fas fa-server"></i>
            </div>
            <div>
                <span class="stat-box-number">@(Model != null && Model.ServerOnline ? "Online" : "Offline")</span>
                <span class="stat-box-label">Tình trạng Server DB</span>
                <span class="stat-box-change up"><i class="fas fa-circle-check me-1"></i>SQL Server</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-box">
            <div class="stat-box-icon green">
                <i class="fas fa-clock"></i>
            </div>
            <div>
                <span class="stat-box-number">@(Model?.MonthlyVisits ?? 0)</span>
                <span class="stat-box-label">Lượt khám (tháng này)</span>
                <span class="stat-box-change up"><i class="fas fa-arrow-up me-1"></i>Thực tế CSDL</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-box">
            <div class="stat-box-icon red">
                <i class="fas fa-triangle-exclamation"></i>
            </div>
            <div>
                <span class="stat-box-number">@(Model?.SystemWarnings ?? 0)</span>
                <span class="stat-box-label">Cảnh báo hệ thống</span>
                <span class="stat-box-change down"><i class="fas fa-check me-1"></i>An toàn</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="dash-card mb-4">
            <div class="dash-card-header">
                <h3 class="dash-card-title">
                    <i class="fas fa-chart-line"></i>
                    Phân bổ người dùng theo vai trò (Thực tế CSDL)
                </h3>
            </div>
            <div class="dash-card-body">
                <div class="row g-4 align-items-center">
                    <div class="col-md-6">
                        <div style="background:conic-gradient(#0ea5e9 @pPct%, #10b981 @pPct% calc(@pPct% + @dPct%), #8b5cf6 calc(@pPct% + @dPct%) calc(@pPct% + @dPct% + @mPct%), #f59e0b calc(@pPct% + @dPct% + @mPct%) calc(@pPct% + @dPct% + @mPct% + @sPct%), #64748b calc(@pPct% + @dPct% + @mPct% + @sPct%) 100%); border-radius:50%; width:220px; height:220px; margin:0 auto; position:relative;">
                            <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center; background:var(--mc-white); border-radius:50%; width:140px; height:140px; display:flex; align-items:center; justify-content:center; flex-direction:column; box-shadow:var(--mc-shadow);">
                                <div style="font-size:0.8rem; color:var(--mc-gray);">Tổng users</div>
                                <div style="font-size:1.6rem; font-weight:800; color:var(--mc-primary-dark);">@(Model?.TotalUsers ?? 0)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1"><span style="font-weight:600;"><i class="fas fa-circle me-2" style="color:#0ea5e9;"></i>Bệnh nhân</span><span style="color:var(--mc-gray); font-weight:600;">@(Model?.PatientCount ?? 0) <strong style="color:var(--mc-dark);">@pPct%</strong></span></div>
                            <div class="progress" style="height:8px; border-radius:4px;"><div class="progress-bar" style="width:@pPct%; background:#0ea5e9;"></div></div>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1"><span style="font-weight:600;"><i class="fas fa-circle me-2" style="color:#10b981;"></i>Bác sĩ</span><span style="color:var(--mc-gray); font-weight:600;">@(Model?.DoctorCount ?? 0) <strong style="color:var(--mc-dark);">@dPct%</strong></span></div>
                            <div class="progress" style="height:8px; border-radius:4px;"><div class="progress-bar" style="width:@dPct%; background:#10b981;"></div></div>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1"><span style="font-weight:600;"><i class="fas fa-circle me-2" style="color:#8b5cf6;"></i>Quản lý phòng khám</span><span style="color:var(--mc-gray); font-weight:600;">@(Model?.ManagerCount ?? 0) <strong style="color:var(--mc-dark);">@mPct%</strong></span></div>
                            <div class="progress" style="height:8px; border-radius:4px;"><div class="progress-bar" style="width:@mPct%; background:#8b5cf6;"></div></div>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1"><span style="font-weight:600;"><i class="fas fa-circle me-2" style="color:#f59e0b;"></i>Nhân viên</span><span style="color:var(--mc-gray); font-weight:600;">@(Model?.StaffCount ?? 0) <strong style="color:var(--mc-dark);">@sPct%</strong></span></div>
                            <div class="progress" style="height:8px; border-radius:4px;"><div class="progress-bar" style="width:@sPct%; background:#f59e0b;"></div></div>
                        </div>
                        <div>
                            <div class="d-flex justify-content-between mb-1"><span style="font-weight:600;"><i class="fas fa-circle me-2" style="color:#64748b;"></i>Admin hệ thống</span><span style="color:var(--mc-gray); font-weight:600;">@(Model?.AdminCount ?? 0) <strong style="color:var(--mc-dark);">@aPct%</strong></span></div>
                            <div class="progress" style="height:8px; border-radius:4px;"><div class="progress-bar" style="width:@aPct%; background:#64748b;"></div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
